---
const { nom, texte, note } = Astro.props;
---

<div class="testimonial">
  <div class="testimonial-content">
    <p class="testimonial-text">{texte}</p>
  </div>
  <div class="testimonial-footer">
    <p class="testimonial-author">{nom}</p>
    <div class="testimonial-rating">
      {"⭐".repeat(note)}
    </div>
  </div>
</div>

<style>
  .testimonial {
    background: #f8f9fa;
    padding: 1.5rem;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 250px;
    transition: all 0.3s ease;
    width: 100%;
    box-sizing: border-box;
  }

  .testimonial:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 102, 204, 0.15);
  }

  .testimonial-content {
    flex: 1;
    margin-bottom: 1rem;
    width: 100%;
    overflow: hidden;
  }

  .testimonial-text {
    color: var(--gray);
    line-height: 1.6;
    font-size: 0.95rem;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 100%;
    
    /* FORCE le retour à la ligne */
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
    word-break: break-word !important;
    white-space: normal !important;
    hyphens: auto;
    
    /* Empêche tout débordement */
    overflow: hidden;
    text-overflow: clip;
  }

  .testimonial-footer {
    border-top: 2px solid #e0e0e0;
    padding-top: 0.75rem;
    margin-top: auto;
    flex-shrink: 0;
    width: 100%;
  }

  .testimonial-author {
    font-weight: 600;
    color: var(--dark);
    margin: 0 0 0.25rem 0;
    font-size: 1rem;
  }

  .testimonial-rating {
    color: #fbbf24;
    font-size: 1.1rem;
  }
</style>