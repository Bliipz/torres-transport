---
const { numero, titre, description } = Astro.props;
---

<div class="process-card">
  <div class="card-header">
    <span class="step-number">{numero}</span>
    <h3>{titre}</h3>
  </div>
  <p class="card-description">{description}</p>
</div>

<style>
  .process-card {
    position: relative;
    padding: 2rem;
    border-radius: 16px;
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
    
    background: #ffffff;
    border: 2px solid #000;  /* Bordure NOIRE */
    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
  }

  .process-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.2);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .step-number {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    font-weight: 700;
    flex-shrink: 0;
    background: #f5de7e;
    color: #000;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.15);
  }

  .card-header h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.4;
    color: #000;
  }

  .card-description {
    color: #333;
    line-height: 1.7;
    margin: 0;
    font-size: 0.98rem;
  }

  @media (max-width: 768px) {
    .process-card {
      padding: 1.5rem;
    }

    .step-number {
      width: 42px;
      height: 42px;
      font-size: 1.2rem;
    }

    .card-header h3 {
      font-size: 1.1rem;
    }

    .card-description {
      font-size: 0.93rem;
    }
  }
</style>