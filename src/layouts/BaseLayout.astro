---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { titre } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Torres Transport - Déménagement et transport à Annemasse">
  <title>{titre} - Torres Transport</title>
</head>
<body>
  <Header />
  
  <main>
    <slot />
  </main>
  
  <Footer />
</body>
</html>