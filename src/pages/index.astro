---
import BaseLayout from "../layouts/BaseLayout.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
import { COMPANY } from "../data/company";
import { makeFAQPage } from "../lib/schemas";

// Services proposés
const services = [
  { num: "01", titre: "Déménagement", excerpt: "Résidentiel pour particuliers, en local ou longue distance. Une équipe complète pour un transfert sans accroc.", link: "/services/demenagement" },
  { num: "02", titre: "Transport", excerpt: "Livraison de meubles, marchandises et objets volumineux à travers la Haute-Savoie.", link: "/services/transport" },
  { num: "03", titre: "Montage de meubles", excerpt: "IKEA, Conforama, BUT. Outils fournis, montage soigné, prêt à vivre.", link: "/services/montage-meubles" },
  { num: "04", titre: "Manutention", excerpt: "Objets lourds, encombrants, accès difficiles. Notre savoir-faire évite les blessures.", link: "/services/manutention" },
  { num: "05", titre: "Débarras", excerpt: "Caves, greniers, appartements. Tri sélectif, recyclage et dons aux associations.", link: "/services/debarras" },
];

// Étapes du process
const etapes = [
  { num: "01", titre: "Premier contact", desc: "Formulaire ou téléphone. Nous vous recontactons sous 24h pour comprendre votre projet et planifier la visite." },
  { num: "02", titre: "Visite technique gratuite", desc: "Ludovic se déplace chez vous pour évaluer le volume, vérifier les accès, discuter de vos besoins. Aucun engagement, juste de la mise en confiance." },
  { num: "03", titre: "Devis détaillé", desc: "Proposition transparente après la visite, sans frais cachés. Vous validez en toute sérénité." },
  { num: "04", titre: "Réalisation", desc: "Le jour J, notre équipe prend le relai. Vous récupérez vos biens à destination, intacts." },
];

// FAQ home
const homeFaqs = [
  {
    question: "Combien coûte un déménagement à Annemasse ?",
    reponse: "Le tarif dépend du volume, de la distance et des prestations. Comptez à partir de 350 € pour un studio, 750 € pour un F2/F3 et 1 500 € pour une maison. Tous nos devis sont gratuits, transparents et sans frais cachés.",
  },
  {
    question: "Vous déplacez-vous pour évaluer le déménagement ?",
    reponse: "Oui, systématiquement et gratuitement. Ludovic se rend chez vous pour faire le tour du logement, regarder les accès (escaliers, stationnement, monte-meuble nécessaire), discuter de vos besoins spécifiques et vos contraintes (objets fragiles, animaux, enfants, date imposée). Cette visite technique permet d'établir un devis précis et de poser toutes vos questions en direct. Aucun engagement.",
  },
  {
    question: "En combien de temps recevrai-je mon devis ?",
    reponse: "Sous 24 h ouvrées après la visite technique. Pour une demande urgente, appelez-nous directement, on s'organise sous 2 h.",
  },
  {
    question: "Faites-vous des déménagements longue distance partout en France ?",
    reponse: "Oui, c'est notre quotidien. Annemasse-Lyon, Annemasse-Paris, Annemasse-Marseille, Annemasse-Bordeaux. Devis ferme sous 24h, tarif au km au-delà de la zone locale, aucun surcoût caché.",
  },
  {
    question: "Vos prestations sont-elles assurées ?",
    reponse: "Oui, toutes nos prestations sont couvertes par notre assurance responsabilité civile professionnelle. Vos biens sont protégés du chargement au déchargement, sans surcoût.",
  },
  {
    question: "Faut-il payer un acompte à la signature ?",
    reponse: "Oui, un acompte est demandé à la réservation pour bloquer votre date et éviter les désistements de dernière minute. Le solde est réglé après la prestation. Le montant est indiqué clairement dans le devis.",
  },
];

const homeFaqSchema = makeFAQPage(homeFaqs);
---

<BaseLayout
  title="Déménageur Annemasse · 5/5 (48 avis) · Devis 24h"
  description="Déménageur Annemasse & Haute-Savoie. 20 ans d'expérience, 48 avis Google 5/5. Tarif unique 47,50 €/m³ tout compris. Devis gratuit sous 24h."
  keywords="déménageur Annemasse, déménageur France entière, déménagement longue distance, transport meubles 74, montage de meuble Annemasse, débarras Annemasse, Torres Transport"
  ogImage="/hero-banner.webp"
  preloadImage="/hero-banner.webp"
  structuredData={[homeFaqSchema]}
>
  <!-- ==================== HERO ÉDITORIAL ==================== -->
  <section class="hero">
    <div class="hero-image">
      <img src="/hero-banner.webp" alt="Camion Torres Transport en intervention" width="1920" height="1080" fetchpriority="high" />
      <div class="hero-overlay"></div>
    </div>

    <div class="container hero-container">
      <div class="hero-meta">
        <span class="hero-eyebrow">Torres Transport · Depuis 2024</span>
      </div>

      <h1 class="hero-title">
        Le déménagement,<br />
        <em>en toute sérénité.</em>
      </h1>

      <p class="hero-subtitle">
        Basés en Haute-Savoie, nous intervenons partout en France.
        20 ans d'expérience, service complet, devis transparent sous 24 h.
      </p>

      <div class="hero-actions">
        <a href="/contact" class="btn btn-gold btn-large btn-with-arrow">Demander un devis</a>
        <a href={COMPANY.phone.tel} class="btn btn-ghost btn-large">{COMPANY.phone.display}</a>
      </div>

      <div class="hero-footer">
        <div class="hero-stats">
          <div class="hero-stat">
            <span class="stat-num">20</span>
            <span class="stat-label">années d'expertise</span>
          </div>
          <div class="hero-stat">
            <span class="stat-num">05</span>
            <span class="stat-label">prestations sur-mesure</span>
          </div>
          <div class="hero-stat">
            <span class="stat-num">FR</span>
            <span class="stat-label">France entière</span>
          </div>
        </div>
        <div class="hero-scroll">
          <span>Découvrir</span>
          <span class="hero-scroll-line"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== INTRO ÉDITORIAL ==================== -->
  <section class="section intro-section">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-eyebrow">
          <span class="eyebrow gold">À propos</span>
          <hr class="divider divider-gold" />
        </div>
        <div class="intro-text">
          <h2>
            Une entreprise locale,<br />
            une équipe humaine.
          </h2>
          <p class="lead">
            Riche de <strong>20 ans d'expérience</strong> dans le transport, la livraison et le
            montage de meubles, Torres Transport voit le jour en 2024 à Ville-la-Grand. Notre mission&nbsp;:
            simplifier vos déménagements et transports avec professionnalisme et bienveillance.
          </p>
          <p>
            Notre base est en <strong>Haute-Savoie</strong>, mais nous intervenons <strong>partout en France</strong>.
            Pour les longues distances (Paris, Lyon, Marseille, Bordeaux…), nous établissons
            un devis personnalisé sous 24&nbsp;h, sans surcoût caché.
          </p>
          <a href="/services" class="link-underline">Voir tous nos services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SERVICES ==================== -->
  <section class="section bg-cream services-section" id="services">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow gold">Cinq prestations</span>
        <h2>Un seul prestataire,<br />pour tous vos besoins.</h2>
      </header>

      <div class="services-grid">
        {services.map((s) => (
          <a href={s.link} class="service-item">
            <div class="service-num">{s.num}</div>
            <div class="service-content">
              <h3>{s.titre}</h3>
              <p>{s.excerpt}</p>
              <span class="service-arrow">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== SPÉCIALITÉS ==================== -->
  <section class="section specialites-home">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow gold">Spécialités</span>
        <h2>Deux niches<br /><em>où nous excellons.</em></h2>
      </header>

      <div class="specialites-home-grid">
        <a href="/services/demenagement-senior" class="specialite-tile">
          <span class="specialite-tile-eyebrow">Spécialité 01</span>
          <h3>Déménagement senior &amp; EHPAD</h3>
          <p>
            Entrée en EHPAD, sortie d'hôpital, regroupement familial. Tarif sénior
            <strong>&minus;10%</strong> automatique, équipe formée, intervention sous 48-72&nbsp;h.
          </p>
          <span class="specialite-tile-cta">En savoir plus →</span>
        </a>

        <a href="/services/garde-meuble" class="specialite-tile">
          <span class="specialite-tile-eyebrow">Spécialité 02</span>
          <h3>Garde-meuble &amp; box stockage</h3>
          <p>
            Box nominatifs de <strong>5 à 30+ m³</strong> à partir de
            <strong>35&nbsp;€/mois</strong>. Sans engagement, premier mois offert
            si combiné avec déménagement.
          </p>
          <span class="specialite-tile-cta">Voir les tarifs →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== FONDATEUR ==================== -->
  <section class="section founder-section">
    <div class="container">
      <div class="founder-grid">
        <div class="founder-image">
          <img src="/Ludovic.webp" alt="Ludovic Torres, fondateur de Torres Transport" width="600" height="624" loading="lazy" />
        </div>
        <div class="founder-content">
          <span class="eyebrow gold">Le fondateur</span>
          <h2>Ludovic Torres,<br /><em>20 ans dans le métier.</em></h2>
          <p class="lead">
            Après deux décennies passées dans le transport et la livraison pour une grande chaîne
            de distribution, Ludovic crée Torres Transport en 2024.
          </p>
          <p>
            L'idée&nbsp;: offrir un service de qualité, à taille humaine, où chaque client est connu
            par son prénom et chaque intervention traitée comme la sienne propre. Pas de
            sous-traitance, pas d'intermédiaire&nbsp;: vous êtes en contact direct avec celui qui
            mène le travail.
          </p>
          <blockquote class="founder-quote">
            « Notre mission&nbsp;: simplifier vos déménagements avec
            professionnalisme et bienveillance. »
            <cite>Ludovic Torres</cite>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PROCESS ==================== -->
  <section class="section bg-black process-section">
    <div class="container">
      <header class="section-header section-header-light">
        <span class="eyebrow">Notre méthode</span>
        <h2>Un parcours clair,<br />en quatre étapes.</h2>
      </header>

      <div class="process-grid">
        {etapes.map((e) => (
          <article class="process-step">
            <div class="step-num">{e.num}</div>
            <h3>{e.titre}</h3>
            <p>{e.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== AVIS GOOGLE (live) ==================== -->
  <GoogleReviews />

  <!-- ==================== ZONES (TEASER) ==================== -->
  <section class="section bg-cream zones-teaser">
    <div class="container">
      <div class="zones-grid">
        <div class="zones-text">
          <span class="eyebrow gold">Zones d'intervention</span>
          <h2>Partout en France,<br />expertise locale en Haute-Savoie.</h2>
          <p class="lead">
            Notre base à Ville-la-Grand nous donne une connaissance fine du bassin annemassien
            et de toute la Haute-Savoie. Pour les missions longue distance, nous nous
            déplaçons partout en France. Aucune commune n'est trop loin.
          </p>
          <a href="/zones-intervention" class="btn btn-primary btn-with-arrow">Voir les zones</a>
        </div>
        <ul class="zones-list">
          <li><span>Annemasse</span><span>74100</span></li>
          <li><span>Ville-la-Grand</span><span>74100</span></li>
          <li><span>Étrembières</span><span>74100</span></li>
          <li><span>Vétraz-Monthoux</span><span>74100</span></li>
          <li><span>Gaillard</span><span>74240</span></li>
          <li><span>Saint-Julien-en-Genevois</span><span>74160</span></li>
          <li><span>Thonon-les-Bains</span><span>74200</span></li>
          <li><span>Évian-les-Bains</span><span>74500</span></li>
          <li><span>Annecy</span><span>74000</span></li>
          <li><span>Bonneville</span><span>74130</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ==================== FAQ ==================== -->
  <section class="section faq-section">
    <div class="container container-narrow">
      <header class="section-header text-center">
        <span class="eyebrow gold">Questions fréquentes</span>
        <h2>Vos questions,<br />nos réponses.</h2>
      </header>

      <div class="faq-list">
        {homeFaqs.map((item, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary>
              <span>{item.question}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-answer">
              <p>{item.reponse}</p>
            </div>
          </details>
        ))}
      </div>

      <div class="faq-footer">
        <p>Une autre question&nbsp;?</p>
        <a href="/contact" class="link-underline">Posez-la nous directement</a>
      </div>
    </div>
  </section>

  <!-- ==================== CTA FINAL ==================== -->
  <section class="section bg-black cta-final">
    <div class="container container-narrow text-center">
      <span class="eyebrow">Prêt&nbsp;?</span>
      <h2>Recevez votre devis<br /><em>gratuit en 24h.</em></h2>
      <p class="lead">
        Devis ferme et sans engagement. Une équipe locale qui vous rappelle dans la journée
        pour comprendre votre projet.
      </p>
      <div class="cta-buttons">
        <a href="/contact" class="btn btn-gold btn-large btn-with-arrow">Demander un devis</a>
        <a href={COMPANY.phone.tel} class="btn btn-ghost btn-large">{COMPANY.phone.display}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==================== HERO ==================== */
  .hero {
    position: relative;
    min-height: clamp(540px, 80vh, 900px);
    display: flex;
    align-items: center;
    color: var(--white);
    overflow: hidden;
    margin-top: -76px; /* compense le padding-top du main */
    padding-top: 76px;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.7) 100%),
      linear-gradient(90deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.2) 70%);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  .hero-meta {
    margin-bottom: 2rem;
  }

  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(245, 222, 126, 0.4);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 600;
    line-height: 1.05;
    color: var(--white);
    letter-spacing: -0.03em;
    margin-bottom: 2rem;
    max-width: 880px;
  }

  .hero-title em {
    font-style: italic;
    color: var(--gold);
    font-weight: 500;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.85);
    max-width: 640px;
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 4rem;
  }

  /* Hero footer (stats + scroll) */
  .hero-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .hero-stats {
    display: flex;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    color: var(--white);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero-scroll {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.55);
  }

  .hero-scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, rgba(255,255,255,0.5), transparent);
    animation: scroll-line 2s var(--ease-smooth) infinite;
  }

  @keyframes scroll-line {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  /* ==================== INTRO ==================== */
  .intro-section {
    background: var(--off-white);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 2.5fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .intro-eyebrow {
    padding-top: 0.5rem;
  }

  .intro-eyebrow .divider {
    margin-top: 1rem;
    margin-bottom: 0;
    width: 40px;
  }

  .intro-text h2 {
    margin-bottom: 2rem;
  }

  .intro-text p {
    margin-bottom: 1.25rem;
  }

  .intro-text p:last-of-type {
    margin-bottom: 2rem;
  }

  /* ==================== SECTION HEADER (commun) ==================== */
  .section-header {
    margin-bottom: clamp(3rem, 6vw, 5rem);
    max-width: 720px;
  }

  .section-header.text-center {
    margin-left: auto;
    margin-right: auto;
  }

  .section-header .eyebrow {
    margin-bottom: 1rem;
  }

  .section-header h2 em {
    font-style: italic;
    color: var(--gold-deep);
  }

  .section-header-light h2 {
    color: var(--white);
  }

  /* ==================== SERVICES ==================== */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--border-strong);
    border-left: 1px solid var(--border-strong);
  }

  .service-item {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    padding: clamp(2rem, 4vw, 3rem);
    border-right: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
    text-decoration: none;
    color: inherit;
    background: var(--cream);
    transition: background 0.4s var(--ease-smooth);
    position: relative;
  }

  .service-item:hover {
    background: var(--white);
  }

  .service-item:hover .service-arrow {
    transform: translateX(8px);
    color: var(--gold-deep);
  }

  .service-num {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--gold-deep);
    flex-shrink: 0;
    line-height: 1;
    padding-top: 0.5rem;
  }

  .service-content {
    flex: 1;
    position: relative;
  }

  .service-content h3 {
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    margin-bottom: 0.75rem;
  }

  .service-content p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--gray-600);
    margin: 0;
    padding-right: 2rem;
  }

  .service-arrow {
    position: absolute;
    right: 0;
    bottom: 0;
    font-size: 1.5rem;
    color: var(--gray-400);
    transition: all 0.3s var(--ease-smooth);
  }

  /* ==================== SPÉCIALITÉS HOME ==================== */
  .specialites-home {
    padding: clamp(4rem, 8vw, 6rem) 0;
    background: var(--white);
  }
  .specialites-home-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .specialite-tile {
    display: flex;
    flex-direction: column;
    background: var(--off-white);
    border: 1px solid var(--border);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    text-decoration: none;
    color: var(--black);
    transition: border-color 0.25s, transform 0.25s, background 0.25s;
  }
  .specialite-tile:hover {
    border-color: var(--gold-deep);
    background: var(--white);
    transform: translateY(-3px);
  }
  .specialite-tile-eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--gold-deep);
    font-weight: 600;
    margin-bottom: 0.85rem;
  }
  .specialite-tile h3 {
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .specialite-tile p {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--gray-700);
    margin-bottom: 1.5rem;
    flex: 1;
  }
  .specialite-tile-cta {
    color: var(--gold-deep);
    font-weight: 600;
    font-size: 0.92rem;
    transition: padding-left 0.25s;
  }
  .specialite-tile:hover .specialite-tile-cta {
    padding-left: 0.4rem;
  }

  /* ==================== FONDATEUR ==================== */
  .founder-section {
    background: var(--white);
  }

  .founder-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .founder-image {
    position: relative;
  }

  .founder-image img {
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 4 / 5;
    filter: grayscale(20%);
    transition: filter 0.6s var(--ease-smooth);
  }

  .founder-image:hover img {
    filter: grayscale(0%);
  }

  .founder-content .eyebrow {
    margin-bottom: 1rem;
    display: inline-block;
  }

  .founder-content h2 {
    margin-bottom: 1.5rem;
  }

  .founder-content p {
    margin-bottom: 1.25rem;
  }

