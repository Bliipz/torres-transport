---
import BaseLayout from '../layouts/BaseLayout.astro';
import reviewsData from '../data/google-reviews.json';
import { COMPANY } from '../data/company';
import { SITE_URL, makeBreadcrumb } from '../lib/schemas';

const pageURL = `${SITE_URL}/temoignages`;
const { reviews, rating, user_ratings_total, url: mapsUrl } = reviewsData;

// Sélection : avis avec un texte assez long pour être un vrai témoignage (≥100 car),
// triés par longueur descendante (les plus riches d'abord), max 12 pour garder une
// page éditoriale et pas une simple liste.
const temoignages = reviews
  .filter((r) => r.text && r.text.length >= 100)
  .sort((a, b) => b.text.length - a.text.length)
  .slice(0, 12)
  .map((r) => {
    const parts = r.author_name.trim().split(/\s+/);
    const initiale = (parts[0]?.[0] || '') + (parts[1]?.[0] || parts[0]?.[1] || '');
    return {
      nom: r.author_name,
      initiale: initiale.toUpperCase(),
      date: r.relative_time_description,
      quote: r.text,
      isLocalGuide: r.is_local_guide,
    };
  });

const breadcrumbSchema = makeBreadcrumb([
  { name: 'Accueil', item: '/' },
  { name: 'Témoignages', item: '/temoignages' },
]);

// Schema Review riche pour le SEO (étoiles dans les SERPs)
const reviewsSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE_URL}/#business`,
  name: COMPANY.name,
  url: SITE_URL,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: rating.toFixed(1),
    bestRating: '5',
    worstRating: '1',
    ratingCount: user_ratings_total,
    reviewCount: user_ratings_total,
  },
  review: temoignages.map((t) => ({
    '@type': 'Review',
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5', worstRating: '1' },
    author: { '@type': 'Person', name: t.nom },
    reviewBody: t.quote,
  })),
};

const stats = [
  { num: rating.toFixed(1).replace('.', ','), label: 'Note moyenne Google' },
  { num: user_ratings_total.toString(), label: 'Avis vérifiés' },
  { num: '100%', label: 'Avis 5 étoiles' },
  { num: `${COMPANY.stats.yearsOfExperience}+`, label: "Années d'expérience" },
];
---

<BaseLayout
  title="Témoignages clients · 48 avis Google 5/5 · Torres Transport"
  description={`Témoignages vérifiés Google : ${user_ratings_total} avis 5/5 pour Torres Transport, déménageur Annemasse. Retours de clients réels sur déménagement, transport et débarras.`}
  keywords="avis Torres Transport, témoignages déménageur Annemasse, avis Google déménagement Haute-Savoie, retours clients vérifiés"
  canonical={pageURL}
  structuredData={[breadcrumbSchema, reviewsSchema]}
>
  <!-- HERO -->
  <section class="t-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a><span>/</span><span>Témoignages</span>
      </nav>
      <span class="eyebrow gold">Avis vérifiés Google</span>
      <h1>Témoignages clients <em>Torres Transport,</em><br />déménageur Annemasse.</h1>
      <p class="lead">
        Pas de slogans creux ni de cinq étoiles inventées. Ces témoignages
        sont issus de notre fiche Google Business&nbsp;: <strong>{user_ratings_total} avis vérifiés,
        note moyenne {rating.toFixed(1).replace('.', ',')}/5</strong>. Une sélection des retours
        les plus complets de clients réels.
      </p>
    </div>
  </section>

  <!-- STATS -->
  <section class="t-stats">
    <div class="container container-narrow">
      <ul class="stats-grid">
        {stats.map((s) => (
          <li>
            <span class="stat-num">{s.num}</span>
            <span class="stat-label">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- GRID TÉMOIGNAGES -->
  <section class="t-grid-section">
    <div class="container">
      <div class="t-grid">
        {temoignages.map((t) => (
          <article class="t-card">
            <div class="t-stars" aria-label="5 étoiles sur 5">
              ★ ★ ★ ★ ★
            </div>

            <blockquote>
              <p>« {t.quote} »</p>
            </blockquote>

            <footer class="t-meta">
              <div class="t-avatar">{t.initiale}</div>
              <div class="t-info">
                <span class="t-nom">
                  {t.nom}
                  {t.isLocalGuide && <span class="t-badge" title="Google Local Guide">Local Guide</span>}
                </span>
                <span class="t-where">Avis Google · {t.date}</span>
              </div>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- DISCLAIMER + LIEN GOOGLE -->
  <section class="t-disclaimer">
    <div class="container container-narrow">
      <div class="disclaimer-card">
        <div>
          <span class="eyebrow gold">Transparence</span>
          <h3>Avis 100% vérifiés Google.</h3>
          <p>
            Chacun de ces témoignages provient directement de notre fiche Google
            Business, écrit par un client réel après sa prestation. Aucun avis
            fabriqué, aucun retouche. Pour voir l'intégralité des {user_ratings_total} avis
            (et laisser le vôtre), rendez-vous sur Google.
          </p>
        </div>
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          Voir les {user_ratings_total} avis sur Google
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="t-cta">
    <div class="container container-narrow">
      <div class="cta-card">
        <span class="eyebrow">À votre tour&nbsp;?</span>
        <h2>Rejoignez nos clients<br /><em>satisfaits.</em></h2>
        <p>
          Devis gratuit sous 24 h. Tarif transparent, sans engagement.
          Estimez d'abord en ligne ou contactez-nous directement.
        </p>
        <div class="cta-buttons">
          <a href="/estimation" class="btn btn-primary">Estimer en ligne</a>
          <a href="/contact" class="btn btn-ghost">Demander un devis</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .t-hero {
    background: var(--off-white);
    padding: clamp(5rem, 10vw, 8rem) 0 clamp(3rem, 5vw, 4rem);
    border-bottom: 1px solid var(--border);
    margin-top: -76px;
    padding-top: clamp(6rem, 12vw, 9rem);
  }
  .breadcrumb {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--gray-500);
    margin-bottom: 2rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .breadcrumb a { color: var(--gray-700); }
  .breadcrumb > span:not(:last-child) { opacity: 0.4; }
  .t-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: 0.75rem 0 1.5rem;
    line-height: 1.05;
  }
  .t-hero h1 em { font-style: italic; color: var(--gold-deep); }
  .t-hero .lead { max-width: 720px; }

  /* STATS */
  .t-stats {
    background: var(--white);
    padding: clamp(2.5rem, 5vw, 3.5rem) 0;
    border-bottom: 1px solid var(--border);
  }
  .stats-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
  }
  .stats-grid li {
    background: var(--white);
    padding: 1.5rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .stat-num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--black);
    font-weight: 600;
    line-height: 1;
  }
  .stat-label {
    font-size: 0.78rem;
    color: var(--gray-600);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  /* GRID */
  .t-grid-section {
    background: var(--white);
    padding: clamp(3rem, 6vw, 5rem) 0;
  }

  .t-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .t-card {
    background: var(--white);
    border: 1px solid var(--border);
    padding: 1.75rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    transition: border-color 0.25s var(--ease-smooth);
  }
  .t-card:hover { border-color: var(--gold-deep); }

  .t-stars {
    color: var(--gold-deep);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }

  .t-card blockquote {
    flex: 1;
    margin: 0;
  }
  .t-card blockquote p {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.65;
    font-style: italic;
    color: var(--black);
    margin: 0;
  }

  .t-meta {
    display: grid;
    grid-template-columns: 44px 1fr;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }

  .t-avatar {
    width: 44px;
    height: 44px;
    background: var(--black);
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 50%;
  }

  .t-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .t-nom {
    font-weight: 600;
    color: var(--black);
    font-size: 0.92rem;
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .t-where {
    font-size: 0.76rem;
    color: var(--gray-500);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .t-badge {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gold-deep);
    border: 1px solid var(--gold-deep);
    padding: 0.18rem 0.4rem;
    font-weight: 600;
    white-space: nowrap;
  }

  /* DISCLAIMER */
  .t-disclaimer {
    background: var(--off-white);
    padding: clamp(2.5rem, 5vw, 3.5rem) 0;
    border-top: 1px solid var(--border);
  }
  .disclaimer-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
    padding: 2rem;
    background: var(--white);
    border: 1px solid var(--border);
  }
  .disclaimer-card .eyebrow { display: block; margin-bottom: 0.5rem; }
  .disclaimer-card h3 {
    font-size: 1.2rem;
    font-weight: 500;
    margin-bottom: 0.6rem;
  }
  .disclaimer-card p {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--gray-600);
    margin: 0;
  }
  .disclaimer-card .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    background: var(--black);
    color: var(--white);
    transition: background 0.2s;
    white-space: nowrap;
  }
  .disclaimer-card .btn:hover { background: var(--gray-800); }

  /* CTA */
  .t-cta {
    background: var(--white);
    padding: clamp(3rem, 6vw, 5rem) 0;
  }
  .cta-card {
    background: var(--black);
    color: var(--white);
    padding: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }
  .cta-card .eyebrow {
    color: var(--gold);
    margin-bottom: 1rem;
    display: block;
  }
  .cta-card h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: var(--white);
    margin-bottom: 1rem;
  }
  .cta-card h2 em { font-style: italic; color: var(--gold); }
  .cta-card p {
    color: rgba(255, 255, 255, 0.75);
    max-width: 560px;
    margin: 0 auto 2rem;
  }
  .cta-buttons {
    display: flex;
    gap: 0.85rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .cta-buttons .btn {
    padding: 0.95rem 1.6rem;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s;
  }
  .cta-buttons .btn-primary { background: var(--gold); color: var(--black); }
  .cta-buttons .btn-primary:hover { background: var(--white); }
  .cta-buttons .btn-ghost {
    background: transparent;
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }
  .cta-buttons .btn-ghost:hover { border-color: var(--gold); color: var(--gold); }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .disclaimer-card { grid-template-columns: 1fr; gap: 1.5rem; }
    .t-meta { grid-template-columns: 40px 1fr; }
  }
</style>
