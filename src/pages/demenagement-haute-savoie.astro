---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllCities } from '../data/cities.js';
import { COMPANY } from '../data/company';
import { makeBreadcrumb, makeFAQPage } from '../lib/schemas';

const SITE_URL = 'https://torrestransport.fr';
const pageURL = `${SITE_URL}/demenagement-haute-savoie`;
const allCities = getAllCities();
const sortedCities = [...allCities].sort((a, b) => a.distanceKm - b.distanceKm);

const zones = [
  {
    nom: 'Bassin annemassien',
    description: "Annemasse, Ville-la-Grand, Gaillard, Étrembières, Vétraz-Monthoux, Ambilly, Cranves-Sales, Juvigny, Bonne. Zone de proximité immédiate à 2-8 km de notre base.",
    cities: ['annemasse', 'ville-la-grand', 'gaillard', 'etrembieres', 'vetraz-monthoux', 'ambilly', 'cranves-sales', 'juvigny', 'bonne'],
  },
  {
    nom: 'Genevois français',
    description: "Saint-Julien-en-Genevois, Lucinges, Machilly, Saint-Cergues. Le territoire frontalier français, marqué par une forte demande résidentielle.",
    cities: ['saint-julien-en-genevois', 'lucinges', 'machilly', 'saint-cergues'],
  },
  {
    nom: 'Bas-Chablais & Chablais',
    description: "Bons-en-Chablais, Douvaine, Sciez, Anthy-sur-Léman, Thonon-les-Bains, Évian-les-Bains, Publier (Amphion-les-Bains). De l'arrière-pays au bord du lac Léman.",
    cities: ['bons-en-chablais', 'douvaine', 'sciez', 'anthy-sur-leman', 'thonon-les-bains', 'evian-les-bains', 'publier'],
  },
  {
    nom: 'Faucigny & Mont-Blanc',
    description: "Bonneville, La Roche-sur-Foron, Cluses, Sallanches, Megève, Chamonix-Mont-Blanc. Vallées de l'Arve et accès aux stations.",
    cities: ['bonneville'],
  },
  {
    nom: 'Annecy & son lac',
    description: "Annecy, Annecy-le-Vieux, Sevrier, Veyrier-du-Lac, Talloires. Bassin annécien, à 40-45 min de notre base.",
    cities: ['annecy'],
  },
];

const specificites = [
  {
    titre: "Routes de montagne et accès difficiles",
    desc: "La Haute-Savoie, c'est aussi des routes en lacet, des chemins pentus, des hameaux perchés en altitude. Notre équipe maîtrise ces conditions : véhicules adaptés, chargement renforcé pour les routes accidentées, créneaux matinaux en hiver pour éviter les routes glissantes. Pour les chalets en altitude (Saint-Cergues, Lucinges, Sallanches), nous proposons un véhicule plus petit si l'accès le nécessite, sans surcoût caché.",
  },
  {
    titre: "Lacs et propriétés en bord d'eau",
    desc: "Lac Léman, lac d'Annecy, plan d'eau de Passy : les propriétés en bord de lac ont souvent des accès en pente raide, des chemins privés étroits, des stationnements compliqués. Notre <strong>visite technique gratuite</strong> est particulièrement utile dans ces zones — nous évaluons la praticabilité du chemin pour un camion 20 m³ ou décidons d'utiliser une navette plus petite.",
  },
  {
    titre: "Résidences secondaires fréquentes",
    desc: "La Haute-Savoie compte environ 30% de résidences secondaires (contre 10% en moyenne nationale). Nous gérons régulièrement les déménagements vers/depuis des résidences secondaires : coordination avec un tiers si vous n'êtes pas sur place, livraison sur créneau, dépôt en sécurité avec photos d'inventaire.",
  },
  {
    titre: "Stations de ski et déménagements saisonniers",
    desc: "Les Houches, Saint-Gervais, Megève, Chamonix : déménagements de saisonniers de l'hôtellerie, transferts vers des appartements de service, retours d'expatriation. Tarifs adaptés pour les petits volumes (5-15 m³) typiques des saisonniers. Délais flexibles en début/fin de saison.",
  },
  {
    titre: "Frontaliers Suisse → France",
    desc: "Beaucoup d'habitants travaillent en Suisse (Genève, Lausanne) tout en résidant en France pour des raisons fiscales. Les déménagements en provenance des cantons suisses sont fréquents — nous gérons ce flux avec organisation côté français uniquement (vous nous remettez vos meubles à la frontière ou dans votre nouveau logement français).",
  },
  {
    titre: "Patrimoine ancien et bâti spécifique",
    desc: "Chalets traditionnels, fermes savoyardes rénovées, immeubles haussmanniens à Thonon ou Annecy, villas Belle Époque à Évian-Amphion : ces bâtis ont des contraintes spécifiques (escaliers étroits, planchers anciens, huisseries fragiles). Notre équipe adapte les techniques de portage et de protection en conséquence.",
  },
];

const stats = [
  { num: '23', label: 'Communes Haute-Savoie couvertes' },
  { num: '5,0/5', label: '48 avis Google vérifiés' },
  { num: '20+', label: "Années d'expérience locale" },
  { num: '24h', label: 'Délai de réponse devis' },
];

const faqs = [
  {
    q: "Quelles sont vos zones d'intervention en Haute-Savoie ?",
    r: `Nous intervenons dans <strong>toute la Haute-Savoie (74)</strong>, avec une expertise approfondie sur le <strong>bassin annemassien</strong> (Annemasse, Ville-la-Grand, Gaillard, Étrembières), le <strong>Genevois français</strong> (Saint-Julien-en-Genevois, Lucinges, Machilly), le <strong>Bas-Chablais</strong> (Bons-en-Chablais, Douvaine, Sciez, Anthy-sur-Léman) et le <strong>Chablais lacustre</strong> (Thonon-les-Bains, Évian-les-Bains, Publier-Amphion). Nous nous déplaçons aussi à Annecy, Bonneville, La Roche-sur-Foron et plus loin.`,
  },
  {
    q: "Êtes-vous un déménageur local ou national ?",
    r: `Torres Transport est un <strong>déménageur local indépendant</strong> basé à Ville-la-Grand (à 2 km d'Annemasse) depuis 2024. Notre fondateur Ludovic Torres a 20 ans d'expérience en transport et logistique en Haute-Savoie. Nous ne sommes pas un grand groupe national : <strong>pas de sous-traitance, un seul interlocuteur, équipe locale</strong>. Ce positionnement nous permet d'avoir des tarifs transparents (47,50&nbsp;€/m³ tout compris) et une vraie réactivité locale.`,
  },
  {
    q: "Pouvez-vous déménager dans les zones de montagne en Haute-Savoie ?",
    r: `Oui, nous intervenons régulièrement dans les <strong>zones de montagne</strong> de Haute-Savoie : Saint-Cergues (versant des Voirons), Lucinges, Sallanches, Cluses, voire les stations (Megève, Chamonix, Saint-Gervais). En hiver, nous adaptons nos véhicules (4x4 si nécessaire) et nos créneaux pour éviter les routes glissantes. Aucun surcoût caché pour les accès difficiles — nous évaluons lors de la visite technique gratuite.`,
  },
  {
    q: "Combien coûte un déménagement en Haute-Savoie ?",
    r: `Notre <strong>tarif unique est 47,50&nbsp;€/m³ tout compris</strong> (camion, équipe, protections, manutention, trajet aller-retour). Pour un studio (15-18&nbsp;m³) : ~700-855&nbsp;€. Pour un T2 : 950-1&nbsp;425&nbsp;€. Pour un T3 : 1&nbsp;425-2&nbsp;140&nbsp;€. Pour une maison F5+ : 2&nbsp;850-4&nbsp;750&nbsp;€. La distance dans le département est <strong>intégrée dans le tarif</strong> (pas de surcoût pour Thonon, Annecy, Évian).`,
  },
  {
    q: "Faites-vous du déménagement longue distance depuis la Haute-Savoie ?",
    r: `Oui, nous organisons des déménagements <strong>depuis la Haute-Savoie vers toute la France</strong> : Lyon, Grenoble, Marseille, Toulouse, Paris, Bordeaux, Nantes, etc. Le tarif au m³ reste la base, avec un coût km au-delà du département. <strong>Devis ferme sous 24h, sans surcoût caché.</strong>`,
  },
  {
    q: "Combien de temps à l'avance dois-je réserver en Haute-Savoie ?",
    r: `Idéalement <strong>2 à 4 semaines</strong> pour un déménagement local. En haute saison (juin à septembre), nous recommandons <strong>6 à 8 semaines</strong> d'avance, surtout pour les déménagements en zone touristique (Chablais lacustre, Megève, Annecy). Les urgences sont gérées sous 24-48&nbsp;h selon disponibilité, sans surcoût.`,
  },
  {
    q: "Proposez-vous un tarif réduit pour les seniors ou PMR ?",
    r: `Oui, nous appliquons automatiquement une <strong>remise de 10&nbsp;% sur le tarif total</strong> pour les personnes âgées (65 ans et +) et les personnes à mobilité réduite. La Haute-Savoie compte de nombreuses entrées en EHPAD et résidences seniors — nous avons l'habitude de ces déménagements avec une approche patiente et humaine.`,
  },
  {
    q: "Peut-on combiner déménagement et garde-meuble ?",
    r: `Bien sûr. Nous proposons un <strong>service de garde-meuble à Annemasse</strong> (box nominatifs de 5 à 30+ m³ à partir de 35&nbsp;€/mois), idéal pour les transitions entre deux logements. Combiné avec un déménagement, <strong>le premier mois de box est offert</strong>. Détails sur <a href="/services/garde-meuble">notre page garde-meuble</a>.`,
  },
];

const breadcrumbSchema = makeBreadcrumb([
  { name: 'Accueil', item: '/' },
  { name: 'Déménagement Haute-Savoie', item: pageURL },
]);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Déménagement',
  name: 'Déménagement Haute-Savoie',
  description: "Service complet de déménagement dans toute la Haute-Savoie (74) par Torres Transport, déménageur local basé à Ville-la-Grand depuis 2024 (20 ans d'expérience).",
  provider: {
    '@type': 'MovingCompany',
    '@id': `${SITE_URL}/#business`,
    name: 'Torres Transport',
  },
  areaServed: { '@type': 'AdministrativeArea', name: 'Haute-Savoie' },
  url: pageURL,
  image: `${SITE_URL}/banner-demenagement.webp`,
  offers: {
    '@type': 'Offer',
    price: COMPANY.pricing.perCubicMeter.toFixed(2),
    priceCurrency: COMPANY.pricing.currency,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: COMPANY.pricing.perCubicMeter.toFixed(2),
      priceCurrency: COMPANY.pricing.currency,
      unitText: 'm³',
    },
    availability: 'https://schema.org/InStock',
  },
};

const faqSchema = makeFAQPage(
  faqs.map((f) => ({ question: f.q, reponse: f.r.replace(/<[^>]+>/g, '') }))
);
---

<BaseLayout
  title="Déménageur Haute-Savoie (74) · Tarif transparent 47,50 €/m³ | Torres Transport"
  description="Déménagement en Haute-Savoie par Torres Transport : Annemasse, Thonon, Évian, Annecy, Bonneville, Chablais. Équipe locale, 20 ans d'expérience, 48 avis 5/5. Devis sous 24h, tarif transparent au m³."
  keywords="déménagement Haute-Savoie, déménageur Haute-Savoie, déménagement 74, déménageur 74, entreprise déménagement Haute-Savoie, déménagement local Haute-Savoie, déménagement Annemasse Thonon Évian Annecy"
  canonical={pageURL}
  ogImage="/banner-demenagement.webp"
  structuredData={[breadcrumbSchema, serviceSchema, faqSchema]}
>
  <!-- ==================== HERO ==================== -->
  <section class="hs-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a><span>/</span>
        <span>Déménagement Haute-Savoie</span>
      </nav>
      <span class="eyebrow gold">Déménageur local · département 74</span>
      <h1>Déménageur en Haute-Savoie,<br /><em>expertise locale depuis 20 ans.</em></h1>
      <p class="lead">
        <strong>Torres Transport</strong> est votre déménageur local indépendant pour toute la <strong>Haute-Savoie (74)</strong> :
        du bassin annemassien au Chablais lacustre, du Genevois français au Faucigny, jusqu'à Annecy et son lac.
        Équipe basée à Ville-la-Grand, 20 ans d'expérience terrain, tarif transparent à <strong>47,50&nbsp;€&nbsp;/&nbsp;m³</strong> tout compris.
      </p>
      <div class="hero-stats">
        {stats.map((s) => (
          <div class="hero-stat">
            <span class="hero-stat-num">{s.num}</span>
            <span class="hero-stat-label">{s.label}</span>
          </div>
        ))}
      </div>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-gold btn-large btn-with-arrow">Devis gratuit en 24h</a>
        <a href={COMPANY.phone.tel} class="btn btn-ghost btn-large">{COMPANY.phone.display}</a>
      </div>
    </div>
  </section>

  <!-- ==================== INTRO SEO ==================== -->
  <section class="section intro-seo">
    <div class="container container-narrow">
      <h2>Pourquoi choisir <em>un déménageur local en Haute-Savoie ?</em></h2>
      <p>
        La <strong>Haute-Savoie</strong> n'est pas un département comme les autres. Entre le <strong>lac Léman</strong> au nord,
        le <strong>massif du Mont-Blanc</strong> au sud-est, le <strong>lac d'Annecy</strong> au centre et la <strong>frontière suisse</strong>
        à l'ouest, le territoire combine des contraintes géographiques uniques : routes en lacet, accès en pente,
        propriétés au bord d'eau, stations de ski, hameaux d'altitude.
      </p>
      <p>
        Un déménageur national qui intervient ponctuellement dans le 74 ne maîtrise pas ces spécificités.
        À l'inverse, <strong>Torres Transport est implanté à Ville-la-Grand depuis 2024</strong> (et notre fondateur travaille
        en Haute-Savoie depuis plus de 20 ans). Cette connaissance terrain se traduit par un déménagement plus rapide,
        moins stressant, et sans <strong>mauvaise surprise le jour J</strong>.
      </p>
      <p>
        Nous intervenons pour particuliers (déménagement résidentiel, transport de mobilier, débarras, montage) dans
        <strong>23 communes</strong> de Haute-Savoie listées ci-dessous, et plus largement partout dans le département.
        Le tarif au m³ inclut la distance dans le 74, sans frais cachés pour Thonon, Annecy ou Évian.
      </p>
    </div>
  </section>

  <!-- ==================== ZONES ==================== -->
  <section class="section bg-cream">
    <div class="container container-narrow">
      <header class="section-header">
        <span class="eyebrow gold">5 zones géographiques</span>
        <h2>Toute la Haute-Savoie<br /><em>en proximité.</em></h2>
        <p class="section-intro">
          Notre couverture du département 74 s'organise autour de 5 zones, chacune avec ses spécificités logistiques.
        </p>
      </header>

      <div class="zones-list">
        {zones.map((z) => (
          <article class="zone-card">
            <h3>{z.nom}</h3>
            <p class="zone-desc">{z.description}</p>
            {z.cities.length > 0 && (
              <ul class="zone-cities">
                {z.cities.map((slug) => {
                  const c = allCities.find((city) => city.slug === slug);
                  return c ? (
                    <li><a href={`/demenagement-${c.slug}`}>{c.nom} <span class="city-cp">({c.codePostal})</span></a></li>
                  ) : null;
                })}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== SPÉCIFICITÉS ==================== -->
  <section class="section">
    <div class="container container-narrow">
      <header class="section-header">
        <span class="eyebrow gold">Spécificités locales</span>
        <h2>Notre expertise<br /><em>du terrain haut-savoyard.</em></h2>
        <p class="section-intro">
          20 ans d'interventions en Haute-Savoie nous ont appris à gérer les particularités du département.
          Voici ce qui change avec un déménageur qui connaît le 74.
        </p>
      </header>

      <ul class="specificites-list">
        {specificites.map((s, idx) => (
          <li class="specificite-item">
            <span class="specificite-num">{String(idx + 1).padStart(2, '0')}</span>
            <div>
              <h3>{s.titre}</h3>
              <p set:html={s.desc}></p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ==================== TOUTES LES VILLES ==================== -->
  <section class="section bg-cream">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow gold">Pages communes détaillées</span>
        <h2>Découvrez nos<br /><em>23 pages locales.</em></h2>
        <p class="section-intro">
          Pour chaque commune de notre zone, nous avons rédigé une page dédiée avec
          tarifs, quartiers, FAQ locale et spécificités d'accès.
        </p>
      </header>

      <div class="cities-grid">
        {sortedCities.map((c) => (
          <a href={`/demenagement-${c.slug}`} class="city-card">
            <h3>{c.nom}</h3>
            <span class="city-meta">{c.codePostal} · {c.distanceKm === 0 ? 'Sur place' : `${c.distanceKm} km`}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== FAQ ==================== -->
  <section class="section">
    <div class="container container-narrow">
      <header class="section-header text-center">
        <span class="eyebrow gold">Questions fréquentes</span>
        <h2>Tout savoir<br /><em>sur nos déménagements en Haute-Savoie.</em></h2>
      </header>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p set:html={f.r}></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== CTA FINAL ==================== -->
  <section class="section bg-black cta-final">
    <div class="container container-narrow text-center">
      <span class="eyebrow">Prêt à déménager en Haute-Savoie ?</span>
      <h2>Votre devis ferme,<br /><em>sous 24 heures.</em></h2>
      <p class="lead">
        Visite technique gratuite à domicile, devis transparent sans engagement.
        48 avis Google 5/5, 20 ans d'expérience locale.
      </p>
      <div class="cta-buttons">
        <a href="/contact" class="btn btn-gold btn-large btn-with-arrow">Demander un devis</a>
        <a href={COMPANY.phone.tel} class="btn btn-ghost btn-large">{COMPANY.phone.display}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hs-hero {
    background: var(--off-white);
    padding: clamp(4rem, 8vw, 7rem) 0 clamp(3rem, 5vw, 4rem);
    border-bottom: 1px solid var(--border);
    margin-top: -76px;
    padding-top: clamp(6rem, 12vw, 9rem);
  }
  .breadcrumb {
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.15em;
    color: var(--gray-500); margin-bottom: 2rem;
    display: flex; gap: 0.5rem; align-items: center;
  }
  .breadcrumb a { color: var(--gray-700, #404040); text-decoration: none; }
  .breadcrumb a:hover { color: var(--black); }
  .breadcrumb > span:not(:last-child) { opacity: 0.4; }

  .hs-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    margin: 0.75rem 0 1.5rem; max-width: 920px; line-height: 1.05;
  }
  .hs-hero h1 em { font-style: italic; color: var(--gold-deep); }
  .hs-hero .lead { max-width: 760px; margin-bottom: 2.5rem; }

  .hero-stats {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
    border-top: 1px solid var(--border-strong); margin: 2rem 0;
  }
  .hero-stat {
    display: flex; flex-direction: column; gap: 0.4rem;
    padding: 1.5rem 1rem; border-right: 1px solid var(--border);
  }
  .hero-stat:last-child { border-right: none; }
  .hero-stat-num {
    font-family: var(--font-display); font-size: 1.65rem; font-weight: 600;
    color: var(--black); line-height: 1;
  }
  .hero-stat-label {
    font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--gray-500);
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }

  .intro-seo { background: var(--white); padding: clamp(3rem, 6vw, 4.5rem) 0; }
  .intro-seo h2 {
    font-size: clamp(1.65rem, 3vw, 2.2rem); margin-bottom: 1.5rem;
    color: var(--black); line-height: 1.2;
  }
  .intro-seo h2 em { font-style: italic; color: var(--gold-deep); }
  .intro-seo p {
    color: var(--gray-700); line-height: 1.75; font-size: 1rem;
    margin-bottom: 1.25rem; max-width: 800px;
  }
  .intro-seo strong { color: var(--black); }

  .section-intro {
    margin-top: 1.25rem; max-width: 720px;
    color: var(--gray-700); font-size: 1.05rem; line-height: 1.65;
  }

  /* ZONES */
  .zones-list {
    display: flex; flex-direction: column; gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .zone-card {
    background: var(--white); padding: 2rem;
    border: 1px solid var(--border);
  }
  .zone-card h3 {
    font-size: 1.4rem; margin: 0 0 0.75rem;
    color: var(--black);
  }
  .zone-desc {
    color: var(--gray-700); line-height: 1.7; margin-bottom: 1.25rem;
  }
  .zone-cities {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; gap: 0.5rem;
  }
  .zone-cities li a {
    display: inline-block; padding: 0.4rem 0.85rem;
    background: var(--off-white); color: var(--black);
    text-decoration: none; font-size: 0.85rem;
    border: 1px solid var(--border);
    transition: all 0.2s;
  }
  .zone-cities li a:hover {
    background: var(--black); color: var(--white);
    border-color: var(--black);
  }
  .city-cp { color: var(--gray-500); font-size: 0.78rem; }
  .zone-cities li a:hover .city-cp { color: rgba(255,255,255,0.6); }

  /* SPÉCIFICITÉS */
  .specificites-list {
    list-style: none; padding: 0; margin: 2.5rem 0 0;
    border-top: 1px solid var(--border-strong);
  }
  .specificite-item {
    display: flex; gap: 2rem; padding: 2rem 0;
    border-bottom: 1px solid var(--border);
    align-items: flex-start;
  }
  .specificite-num {
    font-family: var(--font-display); font-size: 1.5rem; font-weight: 500;
    color: var(--gold-deep); flex-shrink: 0; line-height: 1; padding-top: 0.25rem;
  }
  .specificite-item h3 { font-size: 1.25rem; margin: 0 0 0.75rem; color: var(--black); }
  .specificite-item p { color: var(--gray-700); line-height: 1.7; margin: 0; }
  .specificite-item p strong { color: var(--black); }

  /* CITIES GRID */
  .cities-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0; border-top: 1px solid var(--border-strong);
    border-left: 1px solid var(--border-strong); margin-top: 2.5rem;
  }
  .city-card {
    padding: 1.25rem 1.5rem; background: var(--white);
    border-right: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
    text-decoration: none; color: var(--black);
