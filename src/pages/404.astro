---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY } from '../data/company';

const suggestions = [
  { titre: "Accueil", desc: "Retour au point de départ.", href: "/", num: "01" },
  { titre: "Services", desc: "Tout ce qu'on peut faire pour vous.", href: "/services", num: "02" },
  { titre: "Estimer en ligne", desc: "Devis indicatif en 30 secondes.", href: "/estimation", num: "03" },
  { titre: "Zones d'intervention", desc: "Annemasse, Thonon, Annecy, France entière…", href: "/zones-intervention", num: "04" },
  { titre: "Journal", desc: "Conseils et guides déménagement.", href: "/blog", num: "05" },
  { titre: "Contact", desc: "Devis gratuit sous 24 h.", href: "/contact", num: "06" },
];
---

<BaseLayout
  titre="Page introuvable"
  description="Cette page n'existe pas ou a été déplacée. Retrouvez les services, zones, articles et contact de Torres Transport."
  noindex={true}
>
  <section class="error-hero">
    <div class="container container-narrow">
      <span class="error-code">404</span>
      <h1>Cette page<br /><em>n'existe pas.</em></h1>
      <p class="lead">
        Le lien est cassé, la page a été déplacée, ou vous avez mal recopié l'URL.
        Pas de souci, voici où aller à la place.
      </p>
    </div>
  </section>

  <section class="error-suggestions">
    <div class="container container-narrow">
      <header class="suggestions-header">
        <span class="eyebrow gold">Vous cherchiez peut-être</span>
        <h2>Les pages les plus consultées</h2>
      </header>

      <ul class="suggestions-list">
        {suggestions.map((s) => (
          <li>
            <a href={s.href}>
              <span class="sug-num">{s.num}</span>
              <div class="sug-content">
                <span class="sug-titre">{s.titre}</span>
                <span class="sug-desc">{s.desc}</span>
              </div>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="error-cta">
    <div class="container container-narrow">
      <div class="cta-card">
        <h2>Vous préfériez nous parler<br /><em>directement&nbsp;?</em></h2>
        <p>Devis gratuit, réponse sous 24 h. Ou appel direct dans la journée.</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn btn-primary">Demander un devis</a>
          <a href={COMPANY.phone.tel} class="btn btn-ghost">{COMPANY.phone.display}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-hero {
    background: var(--off-white);
    padding: clamp(5rem, 12vw, 9rem) 0 clamp(3rem, 6vw, 5rem);
    margin-top: -76px;
    padding-top: 11rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }

  .error-code {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(5rem, 16vw, 11rem);
    font-weight: 600;
    color: var(--gold-deep);
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
    -webkit-text-stroke: 1px var(--gold-deep);
    -webkit-text-fill-color: transparent;
  }

  .error-hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  .error-hero h1 em { font-style: italic; color: var(--gold-deep); }

  .error-hero .lead {
    max-width: 580px;
    margin: 0 auto;
  }

  /* SUGGESTIONS */
  .error-suggestions {
    background: var(--white);
    padding: clamp(3rem, 6vw, 5rem) 0;
  }

  .suggestions-header {
    margin-bottom: 2.5rem;
  }
  .suggestions-header h2 {
    font-size: clamp(1.6rem, 2.5vw, 2rem);
    margin-top: 0.6rem;
    font-weight: 500;
  }

  .suggestions-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }

  .suggestions-list li {
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .suggestions-list a {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 1.5rem;
    text-decoration: none;
    color: var(--gray-800);
    transition: all 0.25s var(--ease-smooth);
    height: 100%;
  }

  .suggestions-list a:hover {
    background: var(--off-white);
    color: var(--black);
  }

  .suggestions-list a:hover svg {
    transform: translateX(4px);
    color: var(--gold-deep);
  }

  .sug-num {
    font-family: var(--font-display);
    color: var(--gold-deep);
    font-weight: 600;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .sug-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
    min-width: 0;
  }

  .sug-titre {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--black);
    font-weight: 500;
  }

  .sug-desc {
    font-size: 0.85rem;
    color: var(--gray-600);
    line-height: 1.4;
  }

  .suggestions-list svg {
    color: var(--gray-400);
    transition: all 0.25s var(--ease-smooth);
    flex-shrink: 0;
  }

  /* CTA */
  .error-cta {
    background: var(--off-white);
    padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(4rem, 8vw, 6rem);
  }

  .cta-card {
    background: var(--black);
    color: var(--white);
    padding: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }

  .cta-card h2 {
    font-size: clamp(1.85rem, 3.5vw, 2.5rem);
    color: var(--white);
    margin-bottom: 1rem;
  }
  .cta-card h2 em { font-style: italic; color: var(--gold); }

  .cta-card p {
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 2rem;
  }

  .cta-buttons {
    display: flex;
    gap: 0.85rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .cta-buttons .btn {
    padding: 0.95rem 1.6rem;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s;
  }
  .cta-buttons .btn-primary { background: var(--gold); color: var(--black); }
  .cta-buttons .btn-primary:hover { background: var(--white); }
  .cta-buttons .btn-ghost {
    background: transparent;
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }
  .cta-buttons .btn-ghost:hover { border-color: var(--gold); color: var(--gold); }

  @media (max-width: 600px) {
    .suggestions-list { grid-template-columns: 1fr; }
    .suggestions-list li:not(:last-child) { border-bottom: 1px solid var(--border); }
  }
</style>
