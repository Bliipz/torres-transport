---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllCities } from "../../data/cities.js";
import { serviceFaqs } from "../../data/service-faqs.js";
import { getArticlesForService } from "../../data/articles.js";

const SITE_URL = 'https://torrestransport.fr';
const pageURL = `${SITE_URL}/services/demenagement`;
const allCities = getAllCities();
const faqs = (serviceFaqs as Record<string, Array<{ question: string; reponse: string }>>).demenagement || [];
const relatedArticles = getArticlesForService('demenagement', 3);

const partenaires = [
  { nom: "Centrakor", logo: "/partners/centrakor.webp", w: 505, h: 96 },
  { nom: "La Foir'Fouille", logo: "/partners/foir-fouille.svg", w: 174, h: 53 },
  { nom: "Locabox", logo: "/partners/locabox.webp", w: 150, h: 42 },
  { nom: "Resa Box 74", logo: "/partners/resa-box.webp", w: 160, h: 72 },
];

const inclus = [
  "Emballage professionnel & matériel",
  "Démontage / remontage des meubles",
  "Chargement et déchargement",
  "Transport sécurisé",
  "Mise en place dans le nouveau logement",
  "Assurance responsabilité civile incluse",
];

const garanties = [
  "20 ans d'expérience en Haute-Savoie",
  "Devis gratuit, transparent, sans surprise",
  "Pas de sous-traitance, équipe dédiée",
  "Intervention partout en France au départ d'Annemasse",
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Déménagement',
  name: 'Service de déménagement à Annemasse',
  description:
    "Service complet de déménagement résidentiel pour particuliers à Annemasse, Ville-la-Grand et toute la Haute-Savoie. Tarif unique 47,50 €/m³ tout compris.",
  provider: {
    '@type': 'MovingCompany',
    '@id': `${SITE_URL}/#business`,
    name: 'Torres Transport',
  },
  areaServed: [
    { '@type': 'Country', name: 'France' },
    { '@type': 'City', name: 'Annemasse' },
    { '@type': 'City', name: 'Ville-la-Grand' },
    { '@type': 'City', name: 'Gaillard' },
    { '@type': 'City', name: 'Saint-Julien-en-Genevois' },
    { '@type': 'AdministrativeArea', name: 'Haute-Savoie' },
  ],
  url: pageURL,
  image: `${SITE_URL}/banner-demenagement.webp`,
  offers: {
    '@type': 'Offer',
    price: '47.50',
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '47.50',
      priceCurrency: 'EUR',
      unitText: 'm³',
      referenceQuantity: { '@type': 'QuantitativeValue', value: '1', unitText: 'm³' },
    },
    availability: 'https://schema.org/InStock',
    description: 'Tarif unique au m³, tout compris : camion, manutention, protection, sanglage.',
    validFrom: '2026-01-01',
    seller: { '@type': 'MovingCompany', '@id': `${SITE_URL}/#business` },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_URL}/services` },
    { '@type': 'ListItem', position: 3, name: 'Déménagement', item: pageURL },
  ],
};

const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.reponse },
  })),
} : null;

const allSchemas = [serviceSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  title="Déménageur Annemasse - Déménagement Haute-Savoie | Torres Transport"
  description="Déménageur à Annemasse (74). Déménagement résidentiel pour particuliers avec une équipe expérimentée. Emballage, démontage, transport, assurance incluse. Devis gratuit en 24h."
  keywords="déménageur Annemasse, déménagement Annemasse particulier, déménagement Haute-Savoie, déménageur 74, déménagement Ville-la-Grand"
  ogImage="/banner-demenagement.webp"
  structuredData={allSchemas}
>
  <section class="service-hero" style="background-image: url('/banner-demenagement.webp')">
    <div class="hero-overlay"></div>
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a><span>/</span><a href="/services">Services</a><span>/</span><span>Déménagement</span>
      </nav>
      <span class="eyebrow gold">Notre spécialité</span>
      <h1>Déménagement à Annemasse,<br /><em>en toute sérénité.</em></h1>
      <p class="lead">
        Une équipe locale, 20 ans d'expérience, un service complet du premier carton à la
        dernière vis remontée. Votre déménagement à Annemasse, Ville-la-Grand ou toute la
        Haute-Savoie devient un moment serein.
      </p>
      <div class="hero-actions">
        <a href="/estimation?service=demenagement" class="btn btn-gold btn-large btn-with-arrow">Devis gratuit en 24h</a>
        <a href="tel:+33659926814" class="btn btn-ghost btn-large">06 59 92 68 14</a>
      </div>
    </div>
  </section>

  <section class="section intro-section">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-text">
          <span class="eyebrow gold">Service complet</span>
          <h2>Du premier carton<br /><em>à la dernière vis.</em></h2>
          <p class="lead">
            Notre service de déménagement couvre l'intégralité de votre projet. Vous nous
            confiez vos clés, et nous prenons soin de tout&nbsp;: emballage soigné, démontage
            méticuleux des meubles, chargement, transport sécurisé, déchargement et remontage
            sur place.
          </p>
          <p>
            Nous intervenons dans toute la <strong>Haute-Savoie</strong>, du bassin annemassien
            au Chablais, et nous nous déplaçons <strong>partout en France</strong> pour les
            missions longue distance (Lyon, Paris, Marseille, Bordeaux…).
          </p>
        </div>
        <div class="intro-stats">
          <div class="stat-item"><span class="stat-num">20</span><span class="stat-label">années d'expérience</span></div>
          <div class="stat-item"><span class="stat-num">24h</span><span class="stat-label">devis garanti</span></div>
          <div class="stat-item"><span class="stat-num">5,0/5</span><span class="stat-label">48 avis Google</span></div>
          <div class="stat-item"><span class="stat-num">100%</span><span class="stat-label">assurance incluse</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-cream details-section">
    <div class="container">
      <div class="details-grid">
        <article class="details-card">
          <span class="eyebrow gold">Ce qui est inclus</span>
          <h2>Notre prestation<br />en détail.</h2>
          <ul class="details-list">
            {inclus.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="details-card details-card-dark">
          <span class="eyebrow">Nos garanties</span>
          <h2>Pourquoi<br />Torres Transport.</h2>
          <ul class="details-list details-list-light">
            {garanties.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ==================== VISITE TECHNIQUE ==================== -->
  <section class="section bg-black visite-section">
    <div class="container container-narrow">
      <header class="section-header section-header-light text-center">
        <span class="eyebrow">Notre méthode</span>
        <h2 style="color: var(--white);">Une visite gratuite<br /><em style="color: var(--gold);">avant tout devis.</em></h2>
        <p class="lead" style="color: rgba(255,255,255,0.75); max-width: 720px; margin: 1.5rem auto 0;">
          Aucun devis sérieux ne se fait par téléphone ou par formulaire seul.
          Avant de chiffrer votre projet, <strong style="color: var(--white);">Ludovic se déplace chez vous</strong>,
          fait le tour du logement, vérifie les accès, écoute vos besoins. C'est gratuit,
          sans engagement, et c'est ce qui permet d'établir un devis juste et précis.
        </p>
      </header>

      <ul class="visite-list">
        <li><strong>Tour complet du logement</strong> — pour estimer le volume au m³ près</li>
        <li><strong>Vérification des accès</strong> — escaliers, ascenseur, stationnement, monte-meuble si besoin</li>
        <li><strong>Identification des contraintes</strong> — objets fragiles, animaux, enfants, date imposée</li>
        <li><strong>Discussion sur vos besoins</strong> — emballage, démontage, options sur mesure</li>
        <li><strong>Mise en confiance</strong> — vous parlez directement à celui qui sera là le jour J</li>
      </ul>

      <div style="text-align: center; margin-top: 2.5rem;">
        <a href="/contact" class="btn btn-gold btn-large btn-with-arrow">Planifier ma visite gratuite</a>
      </div>
    </div>
  </section>

  <section class="section partners-section">
    <div class="container">
      <div class="partners-header">
        <span class="eyebrow gold">Ils nous font confiance</span>
        <h2>Partenaires locaux.</h2>
      </div>
      <div class="partners-grid">
        {partenaires.map((p) => (
          <div class="partner-logo">
            <img src={p.logo} alt={p.nom} width={p.w} height={p.h} loading="lazy" decoding="async" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== ZONES (maillage) ==================== -->
  <section class="section service-zones">
    <div class="container container-narrow">
      <header class="section-header">
        <span class="eyebrow gold">Où nous intervenons</span>
        <h2>Déménagement<br /><em>partout en Haute-Savoie.</em></h2>
        <p class="lead">
          Annemasse, Ville-la-Grand, Étrembières, Vétraz-Monthoux, Saint-Julien-en-Genevois,
          Thonon, Évian, Bonneville, Annecy. Cliquez pour découvrir notre offre locale détaillée.
        </p>
      </header>

      <ul class="service-cities">
        {allCities.map((c: any) => (
          <li>
            <a href={`/demenagement-${c.slug}`}>
              <span class="city-name">{c.nom}</span>
              <span class="city-cp">{c.codePostal}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </li>
        ))}
      </ul>

      <div class="service-zones-footer">
        <a href="/zones-intervention" class="link-underline">Carte complète des zones</a>
      </div>
    </div>
  </section>

  <!-- ==================== ARTICLES UTILES ==================== -->
  {relatedArticles.length > 0 && (
    <section class="section bg-cream service-articles">
      <div class="container">
        <header class="section-header">
          <span class="eyebrow gold">À lire pour préparer</span>
          <h2>Nos guides<br /><em>sur le déménagement.</em></h2>
        </header>
        <div class="service-articles-grid">
          {relatedArticles.map((art: any) => (
            <a href={`/blog/${art.slug}`} class="service-article-card">
              <div class="service-article-image">
                <img src={art.image} alt={art.title} width="400" height="210" loading="lazy" decoding="async" />
              </div>
              <div class="service-article-body">
                <span class="article-category">{art.category}</span>
                <h3>{art.title}</h3>
                <p>{art.excerpt}</p>
                <span class="service-article-cta">Lire l'article <span class="arrow">→</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ==================== FAQ ==================== -->
  {faqs.length > 0 && (
    <section class="section service-faq">
      <div class="container container-narrow">
        <header class="section-header">
          <span class="eyebrow gold">Questions fréquentes</span>
          <h2>Vos questions<br /><em>sur le déménagement.</em></h2>
        </header>
        <div class="faq-list">
          {faqs.map((faq: any, idx: number) => (
            <details class="faq-item" open={idx === 0}>
              <summary>
                <h3>{faq.question}</h3>
                <span class="faq-icon" aria-hidden="true"></span>
              </summary>
              <div class="faq-answer">
                <p>{faq.reponse}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section bg-black cta-final">
    <div class="container container-narrow text-center">
      <span class="eyebrow">Prêt à déménager&nbsp;?</span>
      <h2>Recevez votre devis<br /><em>gratuit en 24h.</em></h2>
      <p class="lead">Sans engagement, devis ferme. Une équipe locale qui vous rappelle dans la journée.</p>
      <div class="cta-buttons">
        <a href="/estimation?service=demenagement" class="btn btn-gold btn-large btn-with-arrow">Demander un devis</a>
        <a href="tel:+33659926814" class="btn btn-ghost btn-large">06 59 92 68 14</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-hero {
    position: relative;
    min-height: clamp(440px, 65vh, 620px);
    background-size: cover; background-position: center;
    color: var(--white); display: flex; align-items: center;
    padding: 8rem 0 clamp(3rem, 6vw, 5rem); margin-top: -76px;
  }
  .hero-overlay { position: absolute; inset: 0; z-index: 0; background: linear-gradient(135deg, rgba(0,0,0,0.75), rgba(0,0,0,0.5)); }
  .service-hero .container { position: relative; z-index: 1; }

  .breadcrumb {
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.15em;
    color: rgba(255,255,255,0.7); margin-bottom: 2rem;
    display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;
  }
  .breadcrumb a { color: var(--gold); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb > span:not(:last-child) { opacity: 0.5; }

  .service-hero h1 { color: var(--white); font-size: clamp(2.5rem, 6vw, 4.5rem); margin: 0.75rem 0 1.5rem; max-width: 880px; }
  .service-hero h1 em { font-style: italic; color: var(--gold); }
  .service-hero .lead { color: rgba(255,255,255,0.9); max-width: 720px; margin-bottom: 2.5rem; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  .intro-section { background: var(--white); }
  .intro-grid {
    display: grid; grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 6vw, 5rem); align-items: center;
  }
  .intro-text h2 { margin: 1rem 0 1.5rem; }
  .intro-text h2 em { font-style: italic; color: var(--gold-deep); }
  .intro-text p { margin-bottom: 1.25rem; }

  .intro-stats {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0;
    border-top: 1px solid var(--border-strong); border-left: 1px solid var(--border-strong);
  }
  .stat-item {
    padding: 1.5rem;
    border-right: 1px solid var(--border-strong); border-bottom: 1px solid var(--border-strong);
    display: flex; flex-direction: column; gap: 0.4rem;
  }
  .stat-num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 2.75rem); font-weight: 600;
    color: var(--black); line-height: 1; letter-spacing: -0.02em;
  }
  .stat-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--gray-500); }

  .details-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0;
    border-top: 1px solid var(--border-strong); border-left: 1px solid var(--border-strong);
  }
  .details-card {
    padding: clamp(2.5rem, 4vw, 3.5rem);
    border-right: 1px solid var(--border-strong); border-bottom: 1px solid var(--border-strong);
    background: var(--white);
  }
  .details-card-dark { background: var(--black); color: var(--white); }
  .details-card-dark h2 { color: var(--white); }
  .details-card-dark .eyebrow { color: var(--gold); }
  .details-card .eyebrow { margin-bottom: 1rem; }
  .details-card h2 { font-size: clamp(1.85rem, 3vw, 2.5rem); margin-bottom: 2rem; }

  .details-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .details-list li {
    padding: 0.85rem 0 0.85rem 1.5rem;
    border-bottom: 1px solid var(--border);
    color: var(--gray-700, #404040); position: relative;
  }
  .details-list li::before {
    content: ''; position: absolute; left: 0; top: 1.3rem;
    width: 8px; height: 1px; background: var(--gold-deep);
  }
  .details-list-light li { color: rgba(255,255,255,0.8); border-bottom-color: rgba(255,255,255,0.1); }
  .details-list-light li::before { background: var(--gold); }
  .details-list li:last-child { border-bottom: none; }

  .partners-section { background: var(--off-white); padding: clamp(4rem, 6vw, 5rem) 0; }
  .partners-header { text-align: center; margin-bottom: 3rem; }
  .partners-grid {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .partner-logo img {
    height: 50px; width: auto; object-fit: contain;
    filter: grayscale(100%); opacity: 0.6;
    transition: all 0.3s var(--ease-smooth);
  }
  .partner-logo:hover img { filter: grayscale(0%); opacity: 1; }

  /* ==================== ZONES MAILLAGE ==================== */
  .service-zones { background: var(--white); border-top: 1px solid var(--border); }
  .service-zones .section-header { margin-bottom: 2.5rem; }
  .service-zones .section-header h2 em { font-style: italic; color: var(--gold-deep); }

  .service-cities {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--border);
  }
  .service-cities li {
    border-bottom: 1px solid var(--border);
    border-right: 1px solid var(--border);
  }
  .service-cities li:nth-child(3n) { border-right: none; }
  .service-cities a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    color: var(--gray-800);
    text-decoration: none;
    transition: all 0.25s var(--ease-smooth);
  }
  .service-cities a:hover { background: var(--off-white); color: var(--black); padding-left: 1.5rem; }
  .service-cities a svg { color: var(--gold-deep); transition: transform 0.25s; flex-shrink: 0; }
  .service-cities a:hover svg { transform: translateX(4px); }
  .city-name { font-family: var(--font-display); font-size: 1.05rem; font-weight: 500; flex: 1; }
  .city-cp { font-size: 0.78rem; color: var(--gray-500); letter-spacing: 0.05em; }
  .service-zones-footer { margin-top: 2.5rem; text-align: center; }

  @media (max-width: 800px) {
    .service-cities { grid-template-columns: 1fr; }
    .service-cities li { border-right: none; }
  }

  .cta-final { text-align: center; }
  .cta-final h2 em { font-style: italic; color: var(--gold); }
  .cta-final .lead { color: rgba(255,255,255,0.75); max-width: 640px; margin: 1.5rem auto 2.5rem; }
  .cta-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  /* ==================== ARTICLES UTILES ==================== */
  .service-articles { background: var(--cream); }
  .service-articles .section-header { margin-bottom: 2.5rem; }
  .service-articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .service-article-card {
    background: var(--white);
    border: 1px solid var(--border-strong);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s var(--ease-smooth);
  }
  .service-article-card:hover { border-color: var(--gold-deep); }
  .service-article-card:hover .service-article-cta .arrow { transform: translateX(6px); }
  .service-article-card:hover .service-article-image img { transform: scale(1.04); }
  .service-article-image { overflow: hidden; aspect-ratio: 1200 / 630; }
  .service-article-image img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s var(--ease-smooth);
  }
  .service-article-body { padding: 1.5rem; display: flex; flex-direction: column; flex: 1; }
  .service-article-body .article-category {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--gold-deep); font-weight: 600; margin-bottom: 0.75rem;
  }
  .service-article-body h3 { font-size: 1.15rem; line-height: 1.3; margin-bottom: 0.75rem; }
  .service-article-body p {
    font-size: 0.92rem; color: var(--gray-700, #404040); line-height: 1.55;
    margin-bottom: 1.25rem; flex: 1;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .service-article-cta {
    font-size: 0.78rem; font-weight: 600; color: var(--black);
    text-transform: uppercase; letter-spacing: 0.1em;
  }
  .service-article-cta .arrow { display: inline-block; transition: transform 0.3s var(--ease-smooth); }

  /* ==================== FAQ ==================== */
  .service-faq { background: var(--white); }
  .service-faq .section-header { margin-bottom: 2.5rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .faq-item {
    border: 1px solid var(--border-strong);
    background: var(--white);
    transition: border-color 0.2s var(--ease-smooth);
  }
  .faq-item[open] { border-color: var(--gold-deep); }
  .faq-item summary {
    list-style: none; cursor: pointer; padding: 1.4rem 1.6rem;
    display: flex; justify-content: space-between; align-items: center; gap: 1.5rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary h3 {
    font-family: var(--font-display); font-size: 1.05rem; font-weight: 500;
    color: var(--black); line-height: 1.4; margin: 0;
  }
  .faq-icon { position: relative; width: 16px; height: 16px; flex-shrink: 0; }
  .faq-icon::before, .faq-icon::after {
    content: ''; position: absolute; inset: 50% 0 auto;
    height: 2px; background: var(--gold-deep);
    transform: translateY(-50%); transition: transform 0.3s var(--ease-smooth);
  }
  .faq-icon::after { transform: translateY(-50%) rotate(90deg); }
  .faq-item[open] .faq-icon::after { transform: translateY(-50%) rotate(0deg); }
