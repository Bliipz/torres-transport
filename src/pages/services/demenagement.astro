---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllCities } from "../../data/cities.js";
import { serviceFaqs } from "../../data/service-faqs.js";
import { getArticlesForService } from "../../data/articles.js";
import { COMPANY } from "../../data/company";
import { makeBreadcrumb, makeFAQPage } from "../../lib/schemas";

const SITE_URL = 'https://torrestransport.fr';
const pageURL = `${SITE_URL}/services/demenagement`;
const allCities = getAllCities();
const faqs = (serviceFaqs as Record<string, Array<{ question: string; reponse: string }>>).demenagement || [];
const relatedArticles = getArticlesForService('demenagement', 3);

const partenaires = [
  { nom: "Partenaires Torres Transport", logo: "/partners/partenaires.webp", w: 1888, h: 342 },
];

const inclus = [
  "Emballage professionnel & matériel",
  "Démontage / remontage des meubles",
  "Chargement et déchargement",
  "Transport sécurisé",
  "Mise en place dans le nouveau logement",
  "Assurance responsabilité civile incluse",
];

const garanties = [
  "20 ans d'expérience en Haute-Savoie",
  "Devis gratuit, transparent, sans surprise",
  "Pas de sous-traitance, équipe dédiée",
  "Intervention partout en France au départ d'Annemasse",
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Déménagement',
  name: 'Service de déménagement à Annemasse',
  description:
    "Service complet de déménagement résidentiel pour particuliers à Annemasse, Ville-la-Grand et toute la Haute-Savoie. Tarif unique 47,50 €/m³ tout compris.",
  provider: {
    '@type': 'MovingCompany',
    '@id': `${SITE_URL}/#business`,
    name: 'Torres Transport',
  },
  areaServed: [
    { '@type': 'Country', name: 'France' },
    { '@type': 'City', name: 'Annemasse' },
    { '@type': 'City', name: 'Ville-la-Grand' },
    { '@type': 'City', name: 'Gaillard' },
    { '@type': 'City', name: 'Saint-Julien-en-Genevois' },
    { '@type': 'AdministrativeArea', name: 'Haute-Savoie' },
  ],
  url: pageURL,
  image: `${SITE_URL}/banner-demenagement.webp`,
  offers: {
    '@type': 'Offer',
    price: COMPANY.pricing.perCubicMeter.toFixed(2),
    priceCurrency: COMPANY.pricing.currency,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: COMPANY.pricing.perCubicMeter.toFixed(2),
      priceCurrency: COMPANY.pricing.currency,
      unitText: 'm³',
      referenceQuantity: { '@type': 'QuantitativeValue', value: '1', unitText: 'm³' },
    },
    availability: 'https://schema.org/InStock',
    description: 'Tarif unique au m³, tout compris : camion, manutention, protection, sanglage.',
    validFrom: '2026-01-01',
    seller: { '@type': 'MovingCompany', '@id': `${SITE_URL}/#business` },
  },
};

const breadcrumbSchema = makeBreadcrumb([
  { name: 'Accueil', item: '/' },
  { name: 'Services', item: '/services' },
  { name: 'Déménagement', item: pageURL },
]);

const faqSchema = faqs.length > 0 ? makeFAQPage(faqs) : null;

const allSchemas = [serviceSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  title="Déménageur Annemasse · 47,50 €/m³ tout compris"
  description="Déménageur Annemasse (74) · Particuliers, tarif unique 47,50 €/m³, équipe locale, 48 avis Google 5/5. Visite gratuite, devis 24h."
  keywords="déménageur Annemasse, déménagement Annemasse particulier, déménagement Haute-Savoie, déménageur 74, déménagement Ville-la-Grand"
  ogImage="/banner-demenagement.webp"
  structuredData={allSchemas}
>
  <section class="service-hero" style="background-image: url('/banner-demenagement.webp')">
    <div class="hero-overlay"></div>
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a><span>/</span><a href="/services">Services</a><span>/</span><span>Déménagement</span>
      </nav>
      <span class="eyebrow gold">Notre spécialité</span>
      <h1>Déménagement à Annemasse,<br /><em>en toute sérénité.</em></h1>
      <p class="lead">
        Une équipe locale, 20 ans d'expérience, un service complet du premier carton à la
        dernière vis remontée. Votre déménagement à Annemasse, Ville-la-Grand ou toute la
        Haute-Savoie devient un moment serein.
      </p>
      <div class="hero-actions">
        <a href="/estimation?service=demenagement" class="btn btn-gold btn-large btn-with-arrow">Devis gratuit en 24h</a>
        <a href={COMPANY.phone.tel} class="btn btn-ghost btn-large">{COMPANY.phone.display}</a>
      </div>
    </div>
  </section>

  <section class="section intro-section">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-text">
          <span class="eyebrow gold">Service complet</span>
          <h2>Du premier carton<br /><em>à la dernière vis.</em></h2>
          <p class="lead">
            Notre service de déménagement couvre l'intégralité de votre projet. Vous nous
            confiez vos clés, et nous prenons soin de tout&nbsp;: emballage soigné, démontage
            méticuleux des meubles, chargement, transport sécurisé, déchargement et remontage
            sur place.
          </p>
          <p>
            Nous intervenons dans toute la <strong>Haute-Savoie</strong>, du bassin annemassien
            au Chablais, et nous nous déplaçons <strong>partout en France</strong> pour les
            missions longue distance (Lyon, Paris, Marseille, Bordeaux…).
          </p>
        </div>
        <div class="intro-stats">
          <div class="stat-item"><span class="stat-num">20</span><span class="stat-label">années d'expérience</span></div>
          <div class="stat-item"><span class="stat-num">24h</span><span class="stat-label">devis garanti</span></div>
          <div class="stat-item"><span class="stat-num">5,0/5</span><span class="stat-label">48 avis Google</span></div>
          <div class="stat-item"><span class="stat-num">100%</span><span class="stat-label">assurance incluse</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-cream details-section">
    <div class="container">
      <div class="details-grid">
        <article class="details-card">
          <span class="eyebrow gold">Ce qui est inclus</span>
          <h2>Notre prestation<br />en détail.</h2>
          <ul class="details-list">
            {inclus.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="details-card details-card-dark">
          <span class="eyebrow">Nos garanties</span>
          <h2>Pourquoi<br />Torres Transport.</h2>
          <ul class="details-list details-list-light">
            {garanties.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ==================== VISITE TECHNIQUE ==================== -->
  <section class="section bg-black visite-section">
    <div class="container container-narrow">
      <header class="section-header section-header-light text-center">
        <span class="eyebrow">Notre méthode</span>
        <h2 style="color: var(--white);">Une visite gratuite<br /><em style="color: var(--gold);">avant tout devis.</em></h2>
        <p class="lead" style="color: rgba(255,255,255,0.75); max-width: 720px; margin: 1.5rem auto 0;">
          Aucun devis sérieux ne se fait par téléphone ou par formulaire seul.
          Avant de chiffrer votre projet, <strong style="color: var(--white);">Ludovic se déplace chez vous</strong>,
          fait le tour du logement, vérifie les accès, écoute vos besoins. C'est gratuit,
          sans engagement, et c'est ce qui permet d'établir un devis juste et précis.
        </p>
      </header>

      <ul class="visite-list">
        <li><strong>Tour complet du logement</strong>, pour estimer le volume au m³ près</li>
        <li><strong>Vérification des accès</strong>, escaliers, ascenseur, stationnement, monte-meuble si besoin</li>
        <li><strong>Identification des contraintes</strong>, objets fragiles, animaux, enfants, date imposée</li>
        <li><strong>Discussion sur vos besoins</strong>, emballage, démontage, options sur mesure</li>
        <li><strong>Mise en confiance</strong>, vous parlez directement à celui qui sera là le jour J</li>
      </ul>

      <div style="text-align: center; margin-top: 2.5rem;">
        <a href="/contact" class="btn btn-gold btn-large btn-with-arrow">Planifier ma visite gratuite</a>
      </div>
    </div>
  </section>

  <!-- ==================== TARIF TRANSPARENT AU M³ ==================== -->
  <section class="section bg-off-white tarif-section">
    <div class="container container-narrow">
      <header class="section-header">
        <span class="eyebrow gold">Tarif transparent</span>
        <h2>47,50&nbsp;€&nbsp;/&nbsp;m³,<br /><em>tout compris.</em></h2>
        <p class="lead">
          Notre tarif unique de <strong>47,50&nbsp;€&nbsp;/&nbsp;m³</strong> couvre l'intégralité de la prestation
          standard. Pas de frais cachés, pas de supplément ajouté en cours, pas de "frais de dossier".
          Le devis que vous recevez est celui que vous payez.
        </p>
      </header>

      <div class="tarif-includes">
        <h3>Ce qui est inclus dans le 47,50&nbsp;€&nbsp;/&nbsp;m³</h3>
        <div class="tarif-includes-grid">
          <div class="tarif-include-item">
            <span class="tarif-icon">🚛</span>
            <h4>Le camion adapté</h4>
            <p>20, 30 ou 50 m³ selon votre volume. Camion propre, équipé, climatisé, avec hayon élévateur.</p>
          </div>
          <div class="tarif-include-item">
            <span class="tarif-icon">👥</span>
            <h4>L'équipe complète</h4>
            <p>2 à 4 déménageurs selon le volume. Pas d'intérimaires de dernière minute, pas de sous-traitance.</p>
          </div>
          <div class="tarif-include-item">
            <span class="tarif-icon">🛡️</span>
            <h4>Protection du mobilier</h4>
            <p>Couvertures matelassées, film bulle, film étirable, sangles. Tout le matériel nécessaire.</p>
          </div>
          <div class="tarif-include-item">
            <span class="tarif-icon">📋</span>
            <h4>Assurance responsabilité civile</h4>
            <p>Contrat n° 149 572 243. En cas de casse imputable à notre fait, indemnisation sans franchise.</p>
          </div>
          <div class="tarif-include-item">
            <span class="tarif-icon">📍</span>
            <h4>Trajet aller-retour</h4>
            <p>Depuis notre base de Ville-la-Grand vers votre logement, sans surcoût pour la zone locale.</p>
          </div>
          <div class="tarif-include-item">
            <span class="tarif-icon">⏰</span>
            <h4>Le temps qu'il faut</h4>
            <p>Un seul chantier par jour. Pas de course, pas de fin de tournée bâclée. Le temps nécessaire pour bien faire.</p>
          </div>
        </div>
      </div>

      <div class="tarif-examples">
        <h3>Exemples de tarifs par type de logement</h3>
        <p class="tarif-examples-intro">
          Ces tarifs sont calculés sur la base de volumes moyens observés à Annemasse et en Haute-Savoie. Le volume réel peut varier selon votre mobilier.
        </p>
        <div class="tarif-table">
          <div class="tarif-table-head">
            <span>Type de logement</span>
            <span>Volume moyen</span>
            <span>Tarif estimé</span>
          </div>
          <div class="tarif-table-row">
            <span class="tarif-type">Studio (&lt; 30 m²)</span>
            <span>12 à 18 m³</span>
            <span class="tarif-prix">570 à 855&nbsp;€</span>
          </div>
          <div class="tarif-table-row">
            <span class="tarif-type">T2 (30 à 50 m²)</span>
            <span>20 à 30 m³</span>
            <span class="tarif-prix">950 à 1 425&nbsp;€</span>
          </div>
          <div class="tarif-table-row">
            <span class="tarif-type">T3 (50 à 75 m²)</span>
            <span>30 à 45 m³</span>
            <span class="tarif-prix">1 425 à 2 140&nbsp;€</span>
          </div>
          <div class="tarif-table-row">
            <span class="tarif-type">T4 (75 à 100 m²)</span>
            <span>45 à 60 m³</span>
            <span class="tarif-prix">2 140 à 2 850&nbsp;€</span>
          </div>
          <div class="tarif-table-row">
            <span class="tarif-type">Maison F5+ (&gt; 100 m²)</span>
            <span>60 à 100 m³</span>
            <span class="tarif-prix">2 850 à 4 750&nbsp;€</span>
          </div>
        </div>
        <p class="tarif-options">
          <strong>Options chiffrées séparément (sur devis)</strong>&nbsp;: emballage complet par notre équipe, démontage/remontage poussé du mobilier, garde-meuble temporaire, déménagement longue distance (au km au-delà de la zone Haute-Savoie), créneaux week-end ou jours fériés, monte-meuble si nécessaire.
        </p>
      </div>

      <div class="tarif-cta">
        <a href="/calculateur-volume" class="btn btn-gold btn-large btn-with-arrow">
          Calculer mon volume précis
        </a>
        <a href="/estimation" class="btn btn-ghost-dark btn-large">
          Demander un devis personnalisé
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== JOUR J ==================== -->
  <section class="section jour-j-section">
    <div class="container container-narrow">
      <header class="section-header">
        <span class="eyebrow gold">Le jour J</span>
        <h2>Comment se passe<br /><em>un déménagement chez Torres Transport.</em></h2>
        <p class="lead">
          De l'arrivée de notre équipe le matin à la signature du bordereau le soir : voici exactement
          ce qui se passe sur le terrain. Vous saurez à quoi vous attendre, et nous serons plus
          efficaces ensemble.
        </p>
      </header>

      <ol class="jour-j-steps">
        <li class="jour-j-step">
          <span class="jour-j-time">08h00</span>
          <div class="jour-j-content">
            <h3>Arrivée et briefing</h3>
            <p>
              Notre équipe arrive à l'heure convenue (généralement 8h, ajustable selon votre disponibilité).
              <strong>Tour rapide du logement ensemble</strong> pour valider l'ordre de chargement, identifier
              les meubles fragiles, repérer les contraintes de dernière minute (carton oublié, accès modifié).
            </p>
          </div>
        </li>
        <li class="jour-j-step">
          <span class="jour-j-time">08h30</span>
          <div class="jour-j-content">
            <h3>Protection et démontage</h3>
            <p>
              Nous protégeons les sols (films plastiques aux entrées, cartons posés au sol). Pour les meubles
              concernés par l'option démontage&nbsp;: <strong>démontage soigné</strong> avec sachets de visserie
              numérotés. Les meubles fragiles (vitrines, miroirs, œuvres d'art) sont emballés sur place.
            </p>
          </div>
        </li>
        <li class="jour-j-step">
          <span class="jour-j-time">09h00 - 12h00</span>
          <div class="jour-j-content">
            <h3>Chargement du camion</h3>
            <p>
              Chargement organisé en <strong>strates logiques</strong> : meubles lourds en bas, cartons légers
              en haut, fragile au centre. Sangles tous les 1,5 mètre pour éviter tout mouvement pendant le
              trajet. Les meubles sont systématiquement <strong>protégés par des couvertures matelassées</strong>.
            </p>
          </div>
        </li>
        <li class="jour-j-step">
          <span class="jour-j-time">12h00</span>
          <div class="jour-j-content">
            <h3>État des lieux ancien logement</h3>
            <p>
              Pause si état des lieux à effectuer. Notre équipe peut <strong>vous attendre sur place</strong>
              pendant la procédure (chiffré dans le devis si plus de 30 minutes). Sinon, nous prenons la route
              vers votre nouveau logement.
            </p>
          </div>
        </li>
        <li class="jour-j-step">
          <span class="jour-j-time">13h00 - 14h00</span>
          <div class="jour-j-content">
            <h3>Trajet et déchargement</h3>
            <p>
              <strong>Trajet sécurisé</strong> avec conduite adaptée au chargement. À l'arrivée, déchargement
              en sens inverse&nbsp;: cartons légers d'abord (vous indiquez les pièces), puis meubles. Nos
              déménageurs <strong>installent les meubles à l'emplacement précis</strong> que vous demandez.
            </p>
          </div>
        </li>
        <li class="jour-j-step">
          <span class="jour-j-time">14h00 - 17h00</span>
          <div class="jour-j-content">
            <h3>Remontage et installation</h3>
            <p>
              Remontage des meubles démontés (option), <strong>repositionnement précis</strong> du gros mobilier,
              vérification de l'état général. Tout problème constaté est signalé immédiatement. Petit nettoyage
              de finition&nbsp;: aspirateur si nécessaire, retrait des protections de sol.
            </p>
          </div>
        </li>
        <li class="jour-j-step">
          <span class="jour-j-time">17h00 - 18h00</span>
          <div class="jour-j-content">
            <h3>Bordereau et règlement</h3>
            <p>
              Tour final ensemble pour <strong>valider l'état de la prestation</strong>. Signature du bordereau
              de livraison (mention des éventuels dommages, à signaler à ce moment). Règlement du solde
              (acompte déduit). Notre équipe repart, votre nouvelle vie commence.
            </p>
          </div>
        </li>
      </ol>

      <div class="jour-j-note">
        <strong>⏰ Variabilité&nbsp;:</strong> ces horaires sont indicatifs pour un T2-T3 en local. Pour un studio,
        comptez 3-5 heures total. Pour une maison ou un déménagement longue distance, 1 à 2 journées complètes.
      </div>
    </div>
  </section>

  <!-- ==================== POURQUOI LOCAL ==================== -->
  <section class="section bg-cream pourquoi-local-section">
    <div class="container container-narrow">
      <header class="section-header">
        <span class="eyebrow gold">Déménageur local vs grand groupe</span>
        <h2>Pourquoi choisir<br /><em>un déménageur local d'Annemasse.</em></h2>
        <p class="lead">
          Plusieurs grands groupes nationaux opèrent à Annemasse. Voici concrètement ce qui change
          quand vous choisissez Torres Transport, déménageur indépendant basé à Ville-la-Grand depuis 2024
          (et 20 ans d'expérience terrain en Haute-Savoie avant).
        </p>
      </header>

      <div class="pourquoi-comparison">
        <article class="pourquoi-card pourquoi-card-local">
          <h3>🏔️ Connaissance du terrain</h3>
          <p>
            Notre équipe vit et travaille à Annemasse depuis 20 ans. Nous connaissons <strong>chaque rue,
            chaque accès difficile, chaque parking utilisable</strong>. Stationnement compliqué rue de
            Genève&nbsp;? On sait. Passage étroit au Brouaz ? On a l'astuce. Cette connaissance terrain
            économise des heures sur chaque chantier.
          </p>
        </article>

        <article class="pourquoi-card pourquoi-card-local">
          <h3>👤 Un seul interlocuteur</h3>
          <p>
            <strong>Ludovic Torres en personne</strong> gère votre dossier du devis à la fin de la prestation.
            Pas de transmission entre services commercial → planning → équipe terrain. Pas de "ce n'est pas
            mon dossier". Numéro mobile direct, réponse sous 24h.
          </p>
        </article>

        <article class="pourquoi-card pourquoi-card-local">
          <h3>⚡ Réactivité</h3>
          <p>
            Intervention possible <strong>sous 24-48h</strong> pour les urgences sur Annemasse et le bassin.
            Pour les déménagements planifiés, créneaux disponibles 2-4 semaines à l'avance (contre 6-10 semaines
            chez les grands groupes en haute saison).
          </p>
        </article>

        <article class="pourquoi-card pourquoi-card-local">
          <h3>💶 Tarif transparent</h3>
          <p>
            <strong>47,50&nbsp;€&nbsp;/&nbsp;m³ tout compris</strong>. Pas de frais de dossier ajoutés, pas de
            "supplément étages" facturé en cours. Le devis annoncé est le montant final. Les grands groupes
            cachent souvent des frais dans des annexes ou conditions générales.
          </p>
        </article>

        <article class="pourquoi-card pourquoi-card-local">
          <h3>🚫 Pas de sous-traitance</h3>
          <p>
            L'équipe qui vous reçoit à la visite technique est celle qui réalise votre déménagement. Pas
            d'<strong>intérimaires de dernière minute</strong>, pas de "partenaire local" qui ferait le boulot
            à notre place. Chez les grands groupes, la sous-traitance est fréquente sur la zone Annemasse.
          </p>
        </article>

        <article class="pourquoi-card pourquoi-card-local">
          <h3>🤝 Économie locale</h3>
          <p>
            En choisissant Torres Transport, votre budget reste dans le bassin annemassien : nous employons
            des collaborateurs locaux, achetons nos fournitures chez Centrakor / La Foir'Fouille à Annemasse,
            travaillons avec Locabox pour le garde-meuble. <strong>Circuit court, soutien à l'économie locale.</strong>
          </p>
        </article>
      </div>

      <div class="pourquoi-cta">
        <p>
          <strong>48 avis Google 5,0/5</strong>, 0 avis négatif depuis nos débuts en 2024.
          <a href="/avis-clients">Consulter les avis clients</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section partners-section">
    <div class="container">
      <div class="partners-header">
        <span class="eyebrow gold">Ils nous font confiance</span>
        <h2>Partenaires locaux.</h2>
      </div>
      <div class="partners-grid">
        {partenaires.map((p) => (
          <div class="partner-logo">
            <img src={p.logo} alt={p.nom} width={p.w} height={p.h} loading="lazy" decoding="async" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== ZONES (maillage) ==================== -->
  <section class="section service-zones">
    <div class="container container-narrow">
      <header class="section-header">
        <span class="eyebrow gold">Où nous intervenons</span>
        <h2>Déménagement<br /><em>partout en Haute-Savoie.</em></h2>
        <p class="lead">
          Annemasse, Ville-la-Grand, Étrembières, Vétraz-Monthoux, Saint-Julien-en-Genevois,
          Thonon, Évian, Bonneville, Annecy. Cliquez pour découvrir notre offre locale détaillée.
        </p>
      </header>

      <ul class="service-cities">
        {allCities.map((c: any) => (
          <li>
            <a href={`/demenagement-${c.slug}`}>
              <span class="city-name">{c.nom}</span>
              <span class="city-cp">{c.codePostal}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </li>
        ))}
      </ul>

      <div class="service-zones-footer">
        <a href="/zones-intervention" class="link-underline">Carte complète des zones</a>
      </div>
    </div>
  </section>

  <!-- ==================== ARTICLES UTILES ==================== -->
  {relatedArticles.length > 0 && (
