---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { servicesData } from '../../data/services.js';
import { getAllCities } from '../../data/cities.js';
import { serviceFaqs } from '../../data/service-faqs.js';
import { getArticlesForService } from '../../data/articles.js';

const allCities = getAllCities();

const SITE_URL = 'https://torrestransport.fr';

type ServiceKey = keyof typeof servicesData;

export function getStaticPaths() {
  return (Object.keys(servicesData) as ServiceKey[]).map((slug) => ({
    params: { slug },
    props: { service: servicesData[slug] },
  }));
}

const { service } = Astro.props;
const { slug } = Astro.params;
const pageURL = `${SITE_URL}/services/${slug}`;

const seoTitle = (service as any).seoTitle || `${service.titre} à Annemasse & Haute-Savoie | Torres Transport`;
const seoDescription = (service as any).seoDescription || `${service.description} Intervention à Annemasse, Ville-la-Grand, Saint-Julien et toute la Haute-Savoie. Devis gratuit. 20 ans d'expérience.`;
const seoKeywords = (service as any).seoKeywords || '';

// Tarif au m³ uniquement pertinent pour le service Déménagement
const isDemenagement = slug === 'demenagement';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: service.titre,
  name: service.titre,
  description: service.description,
  provider: {
    '@type': 'MovingCompany',
    '@id': `${SITE_URL}/#business`,
    name: 'Torres Transport',
  },
  areaServed: [
    { '@type': 'Country', name: 'France' },
    { '@type': 'City', name: 'Annemasse' },
    { '@type': 'City', name: 'Ville-la-Grand' },
    { '@type': 'City', name: 'Saint-Julien-en-Genevois' },
    { '@type': 'AdministrativeArea', name: 'Haute-Savoie' },
  ],
  url: pageURL,
  image: service.banner ? `${SITE_URL}${service.banner}` : `${SITE_URL}${service.image}`,
  ...(isDemenagement && {
    offers: {
      '@type': 'Offer',
      price: '47.50',
      priceCurrency: 'EUR',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: '47.50',
        priceCurrency: 'EUR',
        unitText: 'm³',
        referenceQuantity: { '@type': 'QuantitativeValue', value: '1', unitText: 'm³' },
      },
      availability: 'https://schema.org/InStock',
      validFrom: '2026-01-01',
      seller: { '@type': 'MovingCompany', '@id': `${SITE_URL}/#business` },
    },
  }),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `Prestations ${service.titre}`,
    itemListElement: service.details.map((detail: string, idx: number) => ({
      '@type': 'Offer',
      position: idx + 1,
      itemOffered: { '@type': 'Service', name: detail },
    })),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_URL}/services` },
    { '@type': 'ListItem', position: 3, name: service.titre, item: pageURL },
  ],
};

// Articles de blog pertinents pour ce service (internal linking SEO)
const relatedArticles = getArticlesForService(slug as string, 3);

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });

// FAQ schema spécifique au service pour rich snippets Google
const faqs = (serviceFaqs as Record<string, Array<{ question: string; reponse: string }>>)[slug as string] || [];
const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.reponse },
  })),
} : null;

const allSchemas = [serviceSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage={service.banner || service.image}
  structuredData={allSchemas}
>
  <!-- ==================== HERO IMAGE ==================== -->
  <section class="service-hero" style={`background-image: url('${service.banner || service.image}')`}>
    <div class="hero-overlay"></div>
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a>
        <span>/</span>
        <a href="/services">Services</a>
        <span>/</span>
        <span>{service.titre}</span>
      </nav>
      <span class="eyebrow gold">Service</span>
      <h1>{service.titre}</h1>
      <p class="lead">{service.description}</p>
      <div class="hero-actions">
        <a href={`/estimation?service=${slug}`} class="btn btn-gold btn-large btn-with-arrow">Demander un devis</a>
        <a href="tel:+33659926814" class="btn btn-ghost btn-large">06 59 92 68 14</a>
      </div>
    </div>
  </section>

  <!-- ==================== INTRO RÉDIGÉE (si présente) ==================== -->
  {service.intro && (
    <section class="section service-intro">
      <div class="container container-narrow">
        <div class="intro-content" set:html={service.intro}></div>
      </div>
    </section>
  )}

  <!-- ==================== DÉTAILS ==================== -->
  <section class="section service-details">
    <div class="container">
      <div class="details-grid">
        <article class="details-card">
          <span class="eyebrow gold">Ce qui est inclus</span>
          <h2>Notre prestation<br /><em>en détail.</em></h2>
          <ul class="details-list">
            {service.details.map((d: string) => (
              <li>{d}</li>
            ))}
          </ul>
        </article>

        <article class="details-card details-card-dark">
          <span class="eyebrow">Pourquoi nous</span>
          <h2>Nos atouts,<br /><em>vos garanties.</em></h2>
          <ul class="details-list details-list-light">
            {service.avantages.map((a: string) => (
              <li>{a}</li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ==================== ZONES D'INTERVENTION (maillage) ==================== -->
  <section class="section service-zones">
    <div class="container container-narrow">
      <header class="section-header">
        <span class="eyebrow gold">Où nous intervenons</span>
        <h2>{service.titre}<br /><em>partout en Haute-Savoie.</em></h2>
        <p class="lead">
          Nous intervenons dans tout le Genevois français et au-delà.
          Cliquez sur votre ville pour découvrir notre offre locale détaillée.
        </p>
      </header>

      <ul class="service-cities">
        {allCities.map((c: any) => (
          <li>
            <a href={`/demenagement-${c.slug}`}>
              <span class="city-name">{c.nom}</span>
              <span class="city-cp">{c.codePostal}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </li>
        ))}
      </ul>

      <div class="service-zones-footer">
        <a href="/zones-intervention" class="link-underline">Voir la carte complète des zones</a>
      </div>
    </div>
  </section>

  <!-- ==================== ARTICLES UTILES ==================== -->
  {relatedArticles.length > 0 && (
    <section class="section bg-cream service-articles">
      <div class="container">
        <header class="section-header">
          <span class="eyebrow gold">À lire pour préparer</span>
          <h2>Nos guides<br /><em>sur ce service.</em></h2>
        </header>
        <div class="service-articles-grid">
          {relatedArticles.map((art: any) => (
            <a href={`/blog/${art.slug}`} class="service-article-card">
              <div class="service-article-image">
                <img src={art.image} alt={art.title} width="400" height="210" loading="lazy" decoding="async" />
              </div>
              <div class="service-article-body">
                <span class="article-category">{art.category}</span>
                <h3>{art.title}</h3>
                <p>{art.excerpt}</p>
                <span class="service-article-cta">Lire l'article <span class="arrow">→</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ==================== FAQ ==================== -->
  {faqs.length > 0 && (
    <section class="section service-faq">
      <div class="container container-narrow">
        <header class="section-header">
          <span class="eyebrow gold">Questions fréquentes</span>
          <h2>Vos questions<br /><em>sur ce service.</em></h2>
        </header>
        <div class="faq-list">
          {faqs.map((faq: any, idx: number) => (
            <details class="faq-item" open={idx === 0}>
              <summary>
                <h3>{faq.question}</h3>
                <span class="faq-icon" aria-hidden="true"></span>
              </summary>
              <div class="faq-answer">
                <p>{faq.reponse}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ==================== CTA FINAL ==================== -->
  <section class="section bg-cream service-cta">
    <div class="container container-narrow text-center">
      <span class="eyebrow gold">Intéressé par ce service&nbsp;?</span>
      <h2>Recevez votre devis<br /><em>personnalisé en 24h.</em></h2>
      <p class="lead">
        Sans engagement, devis ferme. Une équipe locale qui vous rappelle dans la journée.
      </p>
      <div class="cta-buttons">
        <a href={`/estimation?service=${slug}`} class="btn btn-primary btn-large btn-with-arrow">Demander un devis</a>
        <a href="tel:+33659926814" class="btn btn-secondary btn-large">06 59 92 68 14</a>
        <a href="/services" class="btn btn-ghost btn-large">Tous nos services</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==================== HERO ==================== */
  .service-hero {
    position: relative;
    min-height: clamp(440px, 65vh, 620px);
    background-size: cover;
    background-position: center;
    color: var(--white);
    display: flex;
    align-items: center;
    padding: clamp(4rem, 8vw, 6rem) 0;
    margin-top: -76px;
    padding-top: 8rem;
  }

  /* ==================== INTRO RÉDIGÉE ==================== */
  .service-intro {
    background: var(--white);
    padding: clamp(3.5rem, 6vw, 5rem) 0 clamp(0.5rem, 1vw, 1rem);
  }
  .intro-content {
    font-size: clamp(1rem, 1.1vw, 1.08rem);
    line-height: 1.8;
    color: var(--gray-800);
  }
  .intro-content :global(p) {
    margin-bottom: 1.4rem;
  }
  .intro-content :global(p:last-child) { margin-bottom: 0; }
  .intro-content :global(p:first-of-type) {
    font-size: clamp(1.1rem, 1.25vw, 1.18rem);
    color: var(--black);
    line-height: 1.7;
    border-left: 3px solid var(--gold-deep);
    padding-left: 1.5rem;
    margin-bottom: 1.8rem;
  }
  .intro-content :global(strong) {
    color: var(--black);
    font-weight: 600;
  }
  .intro-content :global(a) {
    color: var(--black);
    border-bottom: 1px solid var(--gold-deep);
    transition: color 0.2s;
  }
  .intro-content :global(a:hover) {
    color: var(--gold-deep);
  }
  .intro-content :global(ol),
  .intro-content :global(ul) {
    margin: 1rem 0 1.4rem;
    padding-left: 1.5rem;
  }
  .intro-content :global(li) {
    margin-bottom: 0.6rem;
    line-height: 1.7;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.5));
    z-index: 0;
  }

  .service-hero .container {
    position: relative;
    z-index: 1;
  }

  .breadcrumb {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 2rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: var(--gold);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb span:first-of-type,
  .breadcrumb > span:not(:last-child) {
    opacity: 0.5;
  }

  .service-hero h1 {
    color: var(--white);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin: 0.75rem 0 1.5rem;
    max-width: 880px;
  }

  .service-hero .lead {
    color: rgba(255, 255, 255, 0.9);
    max-width: 720px;
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ==================== DÉTAILS ==================== */
  .service-details {
    background: var(--white);
  }

  .details-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--border-strong);
    border-left: 1px solid var(--border-strong);
  }

  .details-card {
    padding: clamp(2.5rem, 5vw, 4rem);
    border-right: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
    background: var(--off-white);
  }

  .details-card-dark {
    background: var(--black);
    color: var(--white);
  }

  .details-card-dark h2 {
    color: var(--white);
  }

  .details-card .eyebrow {
    margin-bottom: 1rem;
  }

  .details-card-dark .eyebrow {
    color: var(--gold);
  }

  .details-card h2 {
    font-size: clamp(1.85rem, 3vw, 2.5rem);
    margin-bottom: 2rem;
  }

  .details-card h2 em {
    font-style: italic;
    color: var(--gold-deep);
  }

  .details-card-dark h2 em {
    color: var(--gold);
  }

  .details-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .details-list li {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 1rem;
    color: var(--gray-700, #404040);
    padding-left: 1.5rem;
    position: relative;
  }

  .details-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.3rem;
    width: 8px;
    height: 1px;
    background: var(--gold-deep);
  }

  .details-list-light li {
    color: rgba(255, 255, 255, 0.8);
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .details-list-light li::before {
    background: var(--gold);
  }

  .details-list li:last-child {
    border-bottom: none;
  }

  /* ==================== ZONES D'INTERVENTION ==================== */
  .service-zones {
    background: var(--white);
    border-top: 1px solid var(--border);
  }
  .service-zones .section-header { margin-bottom: 2.5rem; }
  .service-zones .section-header h2 em {
    font-style: italic;
    color: var(--gold-deep);
  }

  .service-cities {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .service-cities li {
    border-bottom: 1px solid var(--border);
    border-right: 1px solid var(--border);
  }
  .service-cities li:nth-child(3n) { border-right: none; }

  .service-cities a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    color: var(--gray-800);
    text-decoration: none;
    transition: all 0.25s var(--ease-smooth);
  }

  .service-cities a:hover {
    background: var(--off-white);
    color: var(--black);
    padding-left: 1.5rem;
  }

  .service-cities a svg {
    color: var(--gold-deep);
    transition: transform 0.25s;
    flex-shrink: 0;
  }

  .service-cities a:hover svg {
    transform: translateX(4px);
  }

  .city-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    flex: 1;
  }

  .city-cp {
    font-size: 0.78rem;
    color: var(--gray-500);
    letter-spacing: 0.05em;
  }

  .service-zones-footer {
    margin-top: 2.5rem;
    text-align: center;
  }

  /* ==================== ARTICLES UTILES ==================== */
  .service-articles { background: var(--cream); }
  .service-articles .section-header { margin-bottom: 2.5rem; }
  .service-articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .service-article-card {
    background: var(--white);
    border: 1px solid var(--border-strong);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s var(--ease-smooth);
  }
  .service-article-card:hover { border-color: var(--gold-deep); }
  .service-article-card:hover .service-article-cta .arrow { transform: translateX(6px); }
  .service-article-card:hover .service-article-image img { transform: scale(1.04); }
  .service-article-image {
    overflow: hidden;
    aspect-ratio: 1200 / 630;
  }
  .service-article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-smooth);
  }
  .service-article-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .service-article-body .article-category {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--gold-deep);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .service-article-body h3 {
    font-size: 1.15rem;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }
  .service-article-body p {
    font-size: 0.92rem;
    color: var(--gray-700, #404040);
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .service-article-cta {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--black);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .service-article-cta .arrow {
    display: inline-block;
    transition: transform 0.3s var(--ease-smooth);
  }

  /* ==================== FAQ ==================== */
  .service-faq { background: var(--white); }
  .service-faq .section-header { margin-bottom: 2.5rem; }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .faq-item {
    border: 1px solid var(--border-strong);
    background: var(--white);
    transition: border-color 0.2s var(--ease-smooth);
  }
  .faq-item[open] { border-color: var(--gold-deep); }
  .faq-item summary {
    list-style: none;
    cursor: pointer;
    padding: 1.4rem 1.6rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary h3 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--black);
    line-height: 1.4;
    margin: 0;
  }
  .faq-icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .faq-icon::before, .faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 2px;
    background: var(--gold-deep);
    transform: translateY(-50%);
    transition: transform 0.3s var(--ease-smooth);
  }
  .faq-icon::after { transform: translateY(-50%) rotate(90deg); }
  .faq-item[open] .faq-icon::after { transform: translateY(-50%) rotate(0deg); }
  .faq-answer {
    padding: 0 1.6rem 1.4rem;
    color: var(--gray-800);
    line-height: 1.7;
  }
  .faq-answer p { margin: 0; font-size: 0.98rem; }

  /* ==================== CTA FINAL ==================== */
  .service-cta {
    text-align: center;
  }

  .service-cta h2 em {
    font-style: italic;
    color: var(--gold-deep);
  }

  .service-cta .lead {
    max-width: 640px;
    margin: 1.5rem auto 2.5rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-ghost {
    background: transparent;
    border: 1px solid var(--border-strong);
    color: var(--black);
  }
  .btn-ghost:hover {
    background: var(--black);
    color: var(--white);
    border-color: var(--black);
  }

  /* ==================== RESPONSIVE ==================== */
  @media (max-width: 1024px) {
    .service-cities {
      grid-template-columns: repeat(2, 1fr);
    }
    .service-cities li:nth-child(3n) { border-right: 1px solid var(--border); }
    .service-cities li:nth-child(2n) { border-right: none; }
  }
  @media (max-width: 800px) {
    .details-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .service-cities {
      grid-template-columns: 1fr;
    }
    .service-cities li,
    .service-cities li:nth-child(3n),
    .service-cities li:nth-child(2n) { border-right: none; }
  }
</style>
