# ============================================================
# Variables d'environnement Torres Transport
# Copier ce fichier en .env et remplir les valeurs.
# Sur Vercel : ajouter ces variables dans Settings > Environment Variables.
# ============================================================

# Resend — Service d'envoi d'emails transactionnels
# 1. Créer un compte sur https://resend.com (gratuit jusqu'à 3 000 emails/mois)
# 2. Vérifier le domaine torrestransport.fr (ajout des DNS records)
# 3. Créer une API Key dans le dashboard
# 4. Coller la clé ci-dessous (commence par re_...)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse expéditrice (doit être sur un domaine vérifié dans Resend)
RESEND_FROM_EMAIL=devis@torrestransport.fr

# Adresse réceptrice — où Ludovic recevra les demandes de devis
CONTACT_TO_EMAIL=contact@torrestransport.fr

# ============================================================
# Google Analytics 4 (GA4) — Mesure d'audience
# 1. Créer un compte sur https://analytics.google.com avec l'email client
# 2. Créer la property "Torres Transport" → web stream sur torrestransport.fr
# 3. Récupérer le Measurement ID (format : G-XXXXXXXXXX)
# 4. Coller ci-dessous
#
# Si vide → GA4 ne charge pas (utile en local pour éviter de polluer les stats).
# La bannière cookies RGPD ne s'affiche que si cette variable est définie.
# ============================================================
PUBLIC_GA4_ID=G-XXXXXXXXXX
